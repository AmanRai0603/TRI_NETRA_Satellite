# release builds (tools/kit.py, tools/macapp.py, tools/build_wheel.py): made by the release workflow
dist/kit/
dist/app/
dist/*.whl
# what each tool ran and wrote (tools/common.py trace)
.trace/
.adcs-index.json
.adcs-index.sqlite*
# the two packages: built by pack_matlab.py and pack_flight.py (the release builds them from a clean checkout)
dist/*.zip
dist/trinetra-drive-pack/
# The design loop's per-iteration scenario files: inputs it writes and flies, then never reads
# again (the iteration's matrix is in loop.json and assess.json). Regenerated by every loop run.
matlab_sils/store/pipeline/*/iter_*/scenarios/
# The V&V report's PDF is kept once, in dist/ (published with every release).
results/vv/TRINETRA_ADCS_VV_report.pdf
build/
