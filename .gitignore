# regenerable run outputs (re-run the scenario to reproduce them)
matlab_sils/store/results/**/channels.csv
matlab_sils/store/results/**/rec.mat
matlab_sils/store/results/**/run_*.mat
matlab_sils/store/logs/
# POP download caches
matlab_sils/pop/data_cache/
*.asv
__pycache__/
matlab_sils/store/results/*.log
matlab_sils/store/trades/**/*.mat
matlab_sils/store/solutions/**/*.mat
fsw/build/
target/
engine/target/
fsw-rs/target/
matlab_sils/store/results_engine/**/channels.csv
matlab_sils/store/results_engine/**/interp.csv
matlab_sils/store/solutions_engine/**/channels.csv
.claude/worktrees/
.claude/settings.local.json
matlab_sils/store/pipeline/cache/
matlab_sils/store/pipeline/**/channels.csv
# release builds (tools/kit.py, tools/macapp.py, tools/build_wheel.py): made by the release workflow
dist/kit/
dist/app/
dist/*.whl
# what each tool ran and wrote (tools/common.py trace)
.trace/
.adcs-index.json
.adcs-index.sqlite*
# the two packages: built by pack_matlab.py and pack_flight.py (the release builds them from a clean checkout)
dist/*.zip
dist/trinetra-drive-pack/
# The design loop's per-iteration scenario files: inputs it writes and flies, then never reads
# again (the iteration's matrix is in loop.json and assess.json). Regenerated by every loop run.
matlab_sils/store/pipeline/*/iter_*/scenarios/
# The V&V report's PDF is kept once, in dist/ (published with every release).
results/vv/TRINETRA_ADCS_VV_report.pdf
build/
# The twin's run figures and result pages: drawn on demand by the one plotting module
# (adcs figures / adcs report, the same as the engine's runs), never committed
matlab_sils/store/results/*/fig*_*.png
matlab_sils/store/results/*/result.html
# The results page and its figures: drawn from the runs' time series, which git does not keep, so
# they are built where the runs were flown (python3 tools/report.py) and never committed; a run's
# figures and report come on demand from the one plotting module (adcs figures, adcs report, the app)
results/figures/
results/index.html

# sealed flight images (tools/flight_build.py seal): 12 MB, rebuilt from the tree; results/flight_images/index.json and
# results/FLIGHT_IMAGES.md say what each held
results/flight_images/*.tnfsw
results/flight_images/*.tnfsw.tmp
matlab_sils/store/refly/
