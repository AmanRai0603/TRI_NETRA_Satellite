## The IAU 2000B nutation in longitude and in obliquity [rad] at t TT centuries since J2000: the 77 luni-solar terms
## summed smallest first, the Delaunay arguments linear in t (McCarthy and Luzum 2003: 485868.249036 + 1717915923.2178 t
## and the like, arcseconds), and the fixed offsets that stand for the planetary terms (-0.135 and +0.388 milliarcseconds).
## What is left out of the 2000A series: its 601 other luni-solar terms, its planetary terms, and the small J2-rate
## scaling of the IAU 2006 adaptation (the nut06a factor, about 1e-6 of the nutation, 1e-5 arcsecond); the abridgement's own
## error is 1 milliarcsecond.
fn nut00b(t: real[1] in -1 .. 1) -> (dpsi: real[1], deps: real[1])
    let as_ = pi/(180.0*3600.0)
    let el = fmod(485868.249036 + 1717915923.2178*t, 1296000.0)*as_
    let elp = fmod(1287104.79305 + 129596581.0481*t, 1296000.0)*as_
    let f = fmod(335779.526232 + 1739527262.8478*t, 1296000.0)*as_
    let d = fmod(1072260.70369 + 1602961601.2090*t, 1296000.0)*as_
    let om = fmod(450160.398036 - 6962890.5431*t, 1296000.0)*as_
    dpsi = 0.0
    deps = 0.0
    for k in 0 .. 77
        let j = 76 - k
        let arg = fmod(NUT00B[j][0]*el + NUT00B[j][1]*elp + NUT00B[j][2]*f + NUT00B[j][3]*d + NUT00B[j][4]*om, 2.0*pi)
        let sa = sin(arg)
        let ca = cos(arg)
        dpsi = dpsi + (NUT00B[j][5] + NUT00B[j][6]*t)*sa + NUT00B[j][7]*ca
        deps = deps + (NUT00B[j][8] + NUT00B[j][9]*t)*ca + NUT00B[j][10]*sa
    end
    dpsi = dpsi*(1e-7*as_) - 0.135e-3*as_
    deps = deps*(1e-7*as_) + 0.388e-3*as_
end

## The IAU 2006 precession as Fukushima-Williams angles [rad] at t TT centuries: gamma_bar, the difference dphi = phi_bar -
## epsilon_A of the other two (phi_bar is the angle between the ecliptic pole of J2000 and the pole of date, epsilon_A the
## mean obliquity, and the two differ by a few milliarcseconds: the polynomial of the difference is the difference of the
## polynomials, so it carries no rounding of two angles of 0.41 rad), psi_bar (the frame bias with the precession of the
## equator and the ecliptic) and epsilon_A itself. The polynomials are those ERFA 2.0.1.5's pfw06 and obl06 hold (the IAU 2006
## precession, the P03 solution of Capitaine, Wallace and Chapront, A&A 412:567 (2003), in the Fukushima-Williams form of
## Wallace and Capitaine, A&A 459:981 (2006): the sources ERFA names; the papers were not to hand and this citation is not
## checked against them). phi_bar of ERFA's pfw06 is dphi + epsilon_A here to 1.2e-16 rad (the rounding of the angle) over 2025.0
## to 2030.0 (tests/test_onboard_frame_oracle.py).
fn fw06(t: real[1] in -1 .. 1) -> (gam: real[1], dphi: real[1], psi: real[1], eps: real[1])
    let as_ = pi/(180.0*3600.0)
    gam = (-0.052928 + (10.556378 + (0.4932044 + (-0.00031238 + (-0.000002788 + 0.0000000260*t)*t)*t)*t)*t)*as_
    dphi = (0.006819 + (0.025753 + (0.0513099 + (-0.00147051 + (0.000000136 + 0.0000000258*t)*t)*t)*t)*t)*as_
    psi = (-0.041775 + (5038.481484 + (1.5584175 + (-0.00018522 + (-0.000026452 - 0.0000000148*t)*t)*t)*t)*t)*as_
    eps = (84381.406 + (-46.836769 + (-0.0001831 + (0.00200340 + (-0.000000576 - 0.0000000434*t)*t)*t)*t)*t)*as_
end

## The matrix R1(-eps) R3(-psi) R1(eps + dphi) R3(gam) (ERFA's fw2m of the angles gam, eps + dphi, psi, eps): from the J2000
## frame to the true equator and equinox of date when psi and eps carry the nutation. R1(-eps) R3(-psi) R1(eps) is written out
## (its elements with 1 - cos(psi) as 2 sin^2(psi/2)) and the small rotation R1(dphi) R3(gam) applied after it, so that the
## small elements of the product (the pole's offset from the J2000 pole, 1e-5 to 1e-3) are sums of small terms, not the
## difference of terms of order 1.
fn npb(gam: real[1] in -0.1 .. 0.1, dphi: real[1] in -0.001 .. 0.001, psi: real[1] in -0.1 .. 0.1, eps: real[1] in 0.3 .. 0.5) -> r: mat3[1]
    let q = 2.0*sin(psi/2.0)*sin(psi/2.0)
    let ce = cos(eps)
    let se = sin(eps)
    let a = [[1.0 - q, -sin(psi)*ce, -sin(psi)*se], [ce*sin(psi), 1.0 - ce*ce*q, -ce*se*q], [se*sin(psi), -ce*se*q, 1.0 - se*se*q]]
    let rd = [[1, 0, 0], [0, cos(dphi), sin(dphi)], [0, -sin(dphi), cos(dphi)]]
    let rg = [[cos(gam), sin(gam), 0], [-sin(gam), cos(gam), 0], [0, 0, 1]]
    r = a*rd*rg
end

## J2000 to the Earth-fixed frame of the onboard clock, at the UTC Julian date jd and the Earth orientation eop = [UT1 - UTC
## [s], pole xp ["], pole yp ["]] the flight parameters hold (set by telecommand): C = W R3(GAST) N P, the IAU 2006
## precession and frame bias with the IAU 2000B nutation (fw06, nut00b, npb), the Greenwich apparent sidereal time GAST = the
## IAU 2006 mean sidereal time (the Earth rotation angle of UT1 = UTC + (UT1 - UTC) plus the polynomial ERFA 2.0.1.5's gmst06
## holds, Capitaine, Wallace and Chapront, A&A 432:355 (2005), the source it names, not checked against the paper) plus the equation of the equinoxes dpsi cos(epsilon_A), and the
## polar motion W = R1(-yp) R2(-xp). The Earth rotation angle takes the whole days and the fraction of the date apart and adds
## UT1 - UTC to the fraction, as ERFA's era00 takes its two-part date, so that a date held to 4e-5 s (a double of 2.46e6 days)
## does not round the change of UT1 - UTC. TT = UTC + 69.184 s (TAI - UTC 37 s since 2017-01-01 plus 32.184 s) is a constant here:
## 1 s of TT moves the precession and nutation by about 1e-6 arcsecond, and the next leap second moves the clock's UTC, not
## the frame. Left out: the complementary terms of the equation of the equinoxes (at most 2.7 milliarcseconds), the TIO
## locator s' (about 1e-5 arcsecond), and the free core nutation and the celestial-pole offsets dX, dY (the IERS publishes
## them; a fraction of a milliarcsecond): all far below an arcsecond. Over 2025.0 to 2030.0 it is within 3 milliarcseconds of the
## IAU 2006/2000A chain of ERFA's c2t06a (2.6 at the eight epochs of tests/test_onboard_frame_oracle.py).
fn eci2ecef(jd: real[1] in 2459000 .. 2463000, eop: real[1][3] in -1 .. 1) -> c: mat3[1]
    let as_ = pi/(180.0*3600.0)
    let t = (jd + 69.184/86400.0 - 2451545.0)/36525.0
    let du = eop[0]/86400.0
    let gam, dphi, psi, eps = fw06(t)
    let dpsi, deps = nut00b(t)
    let rn = npb(gam, dphi - deps, psi + dpsi, eps + deps)
    let era = fmod(fmod(jd, 1.0) + du + 0.7790572732640 + 0.00273781191135448*(jd - 2451545.0 + du), 1.0)
    if era < 0
        era = era + 1.0
    end
    let gmst = 2.0*pi*era + (0.014506 + (4612.156534 + (1.3915817 + (-0.00000044 + (-0.000029956 - 0.0000000368*t)*t)*t)*t)*t)*as_
    let g = gmst + dpsi*cos(eps)
    let rg = [[cos(g), sin(g), 0], [-sin(g), cos(g), 0], [0, 0, 1]]
    let xp = eop[1]*as_
    let yp = eop[2]*as_
    let ry = [[cos(xp), 0, sin(xp)], [0, 1, 0], [-sin(xp), 0, cos(xp)]]
    let rx = [[1, 0, 0], [0, cos(yp), -sin(yp)], [0, sin(yp), cos(yp)]]
    c = rx*ry*rg*rn
end

## The decimal year of a Julian date.
fn decyear(jd: real[1] in 2459000 .. 2463000) -> y: real[1]
    y = 2000.0 + (jd - 2451544.5)/365.25
end

## x reduced to [0, 360).
fn mod360(x: real[1] in -1e6 .. 1e6) -> y: real[1]
    y = fmod(x, 360.0)
    if y < 0
        y = y + 360.0
    end
end

## The unit Sun direction in J2000: the mean-of-date low-precision Sun (Vallado algorithm 29),
## precessed to J2000.
fn sun_model(jd: real[1] in 2459000 .. 2463000) -> s: vec3[1]
    let t = (jd - 2451545.0)/36525.0
    let l = mod360(280.460 + 36000.771*t)
    let m = mod360(357.5291092 + 35999.05034*t)*(pi/180.0)
    let lam = (l + 1.914666471*sin(m) + 0.019994643*sin(2*m))*(pi/180.0)
    let eps = (23.439291 - 0.0130042*t)*(pi/180.0)
    let as_ = pi/(180.0*3600.0)
    let zeta = (2306.2181*t + 0.30188*t*t)*as_
    let z = (2306.2181*t + 1.09468*t*t)*as_
    let th = (2004.3109*t - 0.42665*t*t)*as_
    let sm: vec3[1] = [cos(lam), cos(eps)*sin(lam), sin(eps)*sin(lam)]
    ## s = R3(zeta) R2(-th) R3(z) s_mod
    let a: vec3[1] = [cos(z)*sm[0] + sin(z)*sm[1], -sin(z)*sm[0] + cos(z)*sm[1], sm[2]]
    let b: vec3[1] = [cos(-th)*a[0] - sin(-th)*a[2], a[1], sin(-th)*a[0] + cos(-th)*a[2]]
    let r: vec3[1] = [cos(zeta)*b[0] + sin(zeta)*b[1], -sin(zeta)*b[0] + cos(zeta)*b[1], b[2]]
    s = unit(r)
end

## Geodetic latitude, longitude and height on WGS-84 of an Earth-fixed position (three fixed-point
## passes from Bowring's start).
fn geodetic(r: vec3[m] in -7.2e6 .. 7.2e6) -> (lat: real[1], lon: real[1], h: real[m])
    let a = 6378137.0 [m]
    let f = 1.0/298.257223563
    let e2 = f*(2.0 - f)
    let p = sqrt(r[0]*r[0] + r[1]*r[1])
    lon = atan2(r[1], r[0])
    let la = atan2(r[2], p*(1.0 - e2))
    let nn = a
    let hh: real[m] = 0
    for k in 0 .. 3
        let sl = sin(la)
        nn = a/sqrt(1.0 - e2*sl*sl)
        hh = p/cos(la) - nn
        la = atan2(r[2], p*(1.0 - e2*nn/(nn + hh)))
    end
    lat = la
    h = hh
end

## The Gauss coefficients at a decimal year: straight-line between the two epochs around it,
## extrapolated from the last interval.
fn igrf_gh(dy: real[1] in 2020 .. 2030) -> gh: real[1][195]
    let i = 0
    for ii in 0 .. 25
        if IGRF_YEAR[ii + 1] <= dy
            i = ii + 1
        end
    end
    if i >= 25
        i = 24
    end
    let f = (dy - IGRF_YEAR[i])/(IGRF_YEAR[i + 1] - IGRF_YEAR[i])
    for k in 0 .. 195
        gh[k] = IGRF_GH[i][k] + (IGRF_GH[i + 1][k] - IGRF_GH[i][k])*f
    end
end

## The field in north, east, down [nT] at geodetic latitude, longitude and height [km], to degree
## nmax (at most 13): the Schmidt semi-normalised recursion of the Standard Code's env.igrf.
fn igrf_ned(gh: real[1][195] in -30000 .. 30000, lat: real[1] in -1.5 .. 1.5, lon: real[1] in -3.1 .. 3.1, alt_km: real[1] in 300 .. 900, \
            nmax0: int in 1 .. 13) -> b: vec3[1]
    let re = 6371.2
    let a = 6378.137
    let f = 1.0/298.257223563
    let bb = a*(1.0 - f)
    let ct = cos(pi/2 - lat)
    let st = sin(pi/2 - lat)
    let rho = sqrt((a*st)*(a*st) + (bb*ct)*(bb*ct))
    let r = sqrt(alt_km*alt_km + 2*alt_km*rho + (a*a*a*a*st*st + bb*bb*bb*bb*ct*ct)/(rho*rho))
    let cd = (alt_km + rho)/r
    let sd = (a*a - bb*bb)/rho*ct*st/r
    let oc = ct
    let nmax = nmax0
    if nmax > 13
        nmax = 13
    end
    ct = ct*cd - st*sd
    st = st*cd + oc*sd
    let cphi: real[1][14] = 0
    let sphi: real[1][14] = 0
    for k in 1 .. nmax + 1
        cphi[k] = cos(real(k)*lon)
        sphi[k] = sin(real(k)*lon)
    end
    let pmax = div((nmax + 1)*(nmax + 2), 2)
    let pp: real[1][120] = 0
    let dp: real[1][120] = 0
    pp[0] = 1
    pp[2] = st
    dp[2] = ct
    let a_r = (re/r)*(re/r)
    let m = 1
    let n = 0
    let ci = 0
    let br: real[1] = 0
    let bt: real[1] = 0
    let bp: real[1] = 0
    for pi_ in 2 .. pmax + 1
        let ix = pi_ - 1
        if n < m
            m = 0
            n = n + 1
            a_r = a_r*(re/r)
        end
        if m < n and pi_ != 3
            let l1 = pi_ - n - 1
            let l2 = pi_ - 2*n
            let k1 = (2.0*real(n) - 1)/sqrt(real(n)*real(n) - real(m)*real(m))
            let k2 = sqrt(((real(n) - 1)*(real(n) - 1) - real(m)*real(m))/(real(n)*real(n) - real(m)*real(m)))
            pp[ix] = k1*ct*pp[l1] - k2*pp[l2]
            dp[ix] = k1*(ct*dp[l1] - st*pp[l1]) - k2*dp[l2]
        elif pi_ != 3
            let ln = pi_ - n - 2
            let kk = sqrt(1.0 - 1.0/(2.0*real(m)))
            pp[ix] = kk*st*pp[ln]
            dp[ix] = kk*(st*dp[ln] + ct*pp[ln])
        end
        if m == 0
            let c = a_r*gh[ci]
            br = br + real(n + 1)*c*pp[ix]
            bt = bt - c*dp[ix]
            ci = ci + 1
        else
            let gc = gh[ci]*cphi[m] + gh[ci + 1]*sphi[m]
            let gs = -gh[ci]*sphi[m] + gh[ci + 1]*cphi[m]
            let c = a_r*gc
            br = br + real(n + 1)*c*pp[ix]
            bt = bt - c*dp[ix]
            if st == 0
                bp = bp - ct*a_r*gs*dp[ix]
            else
                bp = bp - 1.0/st*a_r*real(m)*gs*pp[ix]
            end
            ci = ci + 2
        end
        m = m + 1
    end
    let bx = -bt
    let by = bp
    let bz = -br
    b = [bx*cd + bz*sd, by, bz*cd - bx*sd]
end

## The field [T] at an inertial position at a Julian date and Earth orientation eop: to the Earth-fixed frame, geodetic
## coordinates, IGRF in north-east-down, back to J2000.
fn field_eci(r_eci: vec3[m] in -7.2e6 .. 7.2e6, jd: real[1] in 2459000 .. 2463000, eop: real[1][3] in -1 .. 1, \
             gh: real[1][195] in -30000 .. 30000, nmax: int in 1 .. 13) -> b: vec3[1]
    let c = eci2ecef(jd, eop)
    let re = c*r_eci
    let lat, lon, h = geodetic(re)
    let bn = igrf_ned(gh, lat, lon, h/(1000.0 [m]), nmax)
    bn[0] = bn[0]*1e-9
    bn[1] = bn[1]*1e-9
    bn[2] = bn[2]*1e-9
    let sl = sin(lat)
    let cl = cos(lat)
    let so = sin(lon)
    let co = cos(lon)
    let be: vec3[1] = [-sl*co*bn[0] - so*bn[1] - cl*co*bn[2], -sl*so*bn[0] + co*bn[1] - cl*so*bn[2], cl*bn[0] - sl*bn[2]]
    b = mat3t_vec(c, be)
end
