## 02 - Time, frames and onboard models (02_time_frames_models.md): sidereal time, precession, the Earth-fixed frame of
## the onboard clock with the IAU 2000B nutation, the Sun, geodetic coordinates and the IGRF field, operation for operation
## as fsw/src/adcs_env.c and fsw-rs/src/env.rs. Times are Julian dates; the field is in nT from igrf_ned and in T from
## field_eci. The developer's revision S12.5a (T5/E3, DR-env-002), unsigned.
module frames

## The Earth's rotation about z by the Greenwich mean sidereal time (IAU 1982).
fn gmst_rot(jd: real[1] in 2459000 .. 2463000) -> c: mat3[1]
    let t = (jd - 2451545.0)/36525.0
    let g = fmod(67310.54841 + (876600.0*3600.0 + 8640184.812866)*t + 0.093104*t*t - 6.2e-6*t*t*t, 86400.0)
    if g < 0
        g = g + 86400.0
    end
    g = g/240.0*(pi/180.0)
    c = [[cos(g), sin(g), 0], [-sin(g), cos(g), 0], [0, 0, 1]]
end

## J2000 to the mean equator of date (IAU-76 precession): P = R3(-z) R2(theta) R3(-zeta).
fn prec_rot(jd: real[1] in 2459000 .. 2463000) -> p: mat3[1]
    let t = (jd - 2451545.0)/36525.0
    let as_ = pi/(180.0*3600.0)
    let ze = (2306.2181*t + 0.30188*t*t + 0.017998*t*t*t)*as_
    let z = (2306.2181*t + 1.09468*t*t + 0.018203*t*t*t)*as_
    let th = (2004.3109*t - 0.42665*t*t - 0.041833*t*t*t)*as_
    let cz = cos(ze)
    let sz = sin(ze)
    let cc = cos(z)
    let sc = sin(z)
    let ct = cos(th)
    let st = sin(th)
    p = [[cc*ct*cz - sc*sz, -cc*ct*sz - sc*cz, -cc*st], [sc*ct*cz + cc*sz, -sc*ct*sz + cc*cz, -sc*st], [st*cz, -st*sz, ct]]
end

## The IAU 2000B luni-solar nutation series: the 77 terms of McCarthy and Luzum (2003), An abridged model of the
## precession-nutation of the celestial pole, Celestial Mechanics and Dynamical Astronomy 85:37-49 (the abridgement of the
## IAU 2000A series of the IERS Conventions 2003; IERS Conventions 2010, TN36, section 5.5.1). A row: the integer multipliers of
## the Delaunay arguments l, l', F, D, Omega, then the coefficients of the nutation in longitude (sin, t sin, cos) and in
## obliquity (cos, t cos, sin), in units of 0.1 microarcsecond (per Julian century for the t columns). The rows are those of
## the nut00b table of ERFA 2.0.1.5 (the open version of the IAU SOFA library; pyerfa 2.0.1.5, taken from its compiled
## table), the first 77 rows of its IAU 2000A luni-solar table; the printed paper was not to hand, so the transcription is
## not checked against it. The developer's transcription (S12.5a), unsigned.
