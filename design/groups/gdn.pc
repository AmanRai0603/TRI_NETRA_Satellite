## gdn: every computing row of the group, as its nodes state it. Generated by tools/groupcode.py wire from the design's nodes; do not edit.
module gdn

## The rotation taking +Y_B (the nadir axis of the base frame) to the payload axis.
fn boresight_offset(bs_in: vec3[1] in -1 .. 1) -> q: quat
    let ey: vec3[1] = [0, 1, 0]
    let bs = unit(bs_in)
    let ax = cross(ey, bs)
    let c = dot(ey, bs)
    let s = norm(ax)
    if s < 1e-12
        q = [0, 0, 0, 1]
        if c <= 0
            q = [1, 0, 0, 0]
        end
    else
        let k = ax*(1.0/s)
        let kk = skew(k)
        let k2 = kk*kk
        let a: mat3[1] = 0
        for i in 0 .. 3
            for j in 0 .. 3
                a[i][j] = (if i == j then 1.0 else 0.0) + s*kk[i][j] + (1 - c)*k2[i][j]
            end
        end
        q = fromdcm(a)
    end
end

## The passive ECI -> body matrix of q.
fn dcm(q: quat in -1 .. 1) -> a: mat3[1]
    let x = q[0]
    let y = q[1]
    let z = q[2]
    let w = q[3]
    a = [[1 - 2*(y*y + z*z), 2*(x*y + z*w), 2*(x*z - y*w)], \
         [2*(y*x - z*w), 1 - 2*(x*x + z*z), 2*(y*z + x*w)], \
         [2*(z*x + y*w), 2*(z*y - x*w), 1 - 2*(x*x + y*y)]]
end

## The reference of guidance `kind` (0 nadir, 1 target, 2 slew, 3 inertial, 4 Sun) at time t on the
## orbit (r, v): the attitude, its rate in the reference frame, and its rate's derivative.
fn guidance(kind: int in 0 .. 4, r: vec3[m] in -7.2e6 .. 7.2e6, v: vec3[m/s] in -7600 .. 7600, t: real[s] in 0 .. 600, \
            q_off: quat in -1 .. 1, roll_deg: real[1] in -60 .. 60, t0: real[s] in 0 .. 300, t_slew: real[s] in 20 .. 300, \
            axis: vec3[1] in -1 .. 1, q_inertial: quat in -1 .. 1, sun_axis: vec3[1] in -1 .. 1, roll_axis: vec3[1] in -1 .. 1, \
            sun_eci: vec3[1] in -1 .. 1, flip: bool) -> (q_ref: quat, w_ref: vec3[1/s], wd_ref: vec3[1/s^2])
    let rh = unit(r)
    let vh = unit(v)
    let mr = rh*(-1.0)
    let nrm = unit(cross(vh, mr))
    let ram = unit(cross(mr, nrm))
    let rr: mat3[1] = 0
    for i in 0 .. 3
        rr[0][i] = -ram[i]
        rr[1][i] = -rh[i]
        rr[2][i] = -nrm[i]
    end
    let q_nad = fromdcm(rr)
    if q_off[0] != 0 or q_off[1] != 0 or q_off[2] != 0 or q_off[3] != 0
        q_nad = qmult(q_nad, q_off)
    end
    if flip
        let u: vec3[1] = [1, 0, 0]
        if norm(roll_axis) > 0
            u = unit(roll_axis)
        end
        q_nad = qmult(q_nad, [u[0], u[1], u[2], 0])
    end
    let w_orb = cross(r, v)*(1.0/dot(r, r))
    wd_ref = 0
    let ax: vec3[1] = [1, 0, 0]
    if norm(axis) > 0
        ax = unit(axis)
    end
    if kind == 1
        q_ref = qmult(q_nad, fromrotvec(ax*(roll_deg*(pi/180.0))))
        w_ref = dcm(q_ref)*w_orb
    elif kind == 2
        ## the cycloidal slew in the rotating nadir frame
        let tau = clamp((t - t0)/t_slew, 0.0, 1.0)
        let sd: real[1/s] = 0
        let sdd: real[1/s^2] = 0
        let ph = roll_deg*(pi/180.0)
        if t > t0 and t < t0 + t_slew
            sd = (1 - cos(2*pi*tau))/t_slew
            sdd = 2*pi*sin(2*pi*tau)/(t_slew*t_slew)
        end
        let s = tau - sin(2*pi*tau)/(2*pi)
        q_ref = qmult(q_nad, fromrotvec(ax*(ph*s)))
        let wo = dcm(q_ref)*w_orb
        ## the slew frame turns at ax ph s_dot relative to the orbiting frame: transport term on w_orb
        let tr = cross(ax*(ph*sd), wo)
        for i in 0 .. 3
            w_ref[i] = wo[i] + ax[i]*ph*sd
            wd_ref[i] = ax[i]*ph*sdd - tr[i]
        end
    elif kind == 3
        q_ref = q_inertial
        w_ref = 0
    elif kind == 4
        ## Sun referencing: the power face a onto the Sun, b towards the orbit normal
        let a: vec3[1] = [0, 0, -1]
        if norm(sun_axis) > 0
            a = unit(sun_axis)
        end
        let b: vec3[1] = [1, 0, 0]
        if norm(roll_axis) > 0
            b = roll_axis
        end
        let ab = dot(a, b)
        for i in 0 .. 3
            b[i] = b[i] - ab*a[i]
        end
        if norm(b) < 1e-6
            b = [-a[1]*a[0], 1 - a[1]*a[1], -a[1]*a[2]]
        end
        b = unit(b)
        let s = unit(sun_eci)
        let e2: vec3[1] = 0
        for i in 0 .. 3
            e2[i] = nrm[i] - dot(nrm, s)*s[i]
        end
        if norm(e2) < 1e-6
            e2 = [-s[2]*s[0], -s[2]*s[1], 1 - s[2]*s[2]]
        end
        e2 = unit(e2)
        let b3 = cross(a, b)
        let e3 = cross(s, e2)
        let m: mat3[1] = 0
        for i in 0 .. 3
            for j in 0 .. 3
                m[i][j] = a[i]*s[j] + b[i]*e2[j] + b3[i]*e3[j]
            end
        end
        q_ref = fromdcm(m)
        w_ref = 0
    else
        q_ref = q_nad
        w_ref = dcm(q_nad)*w_orb
    end
end

## The parameters the mode manager reads (adcs_params_t; auto_next 255 is none).
record ModeParams
    auto_next: int in 0 .. 12
    n_sched: int in 0 .. 8
    sched_t: real[1][8] in 0 .. 3000
    sched_mode: int[8] in 0 .. 10
    detumble_exit: real[1] in 0 .. 0.1
    detumble_hold_s: real[1] in 0 .. 100
    ss_law: int in 0 .. 2
    ss_omega_max_dps: real[1] in 1 .. 20
    ss_spin_dps: real[1] in 1 .. 10
    ss_z_in_dps: real[1] in 0.1 .. 3
    ss_perp_in_dps: real[1] in 0.1 .. 3
    ss_t_check_s: real[1] in 10 .. 300
    ss_sun_min: real[1] in -1 .. 1
    ss_dwell_in_s: real[1] in 1 .. 100
    ss_omega_exit_dps: real[1] in 0.1 .. 3
    ss_perp_out_dps: real[1] in 0.5 .. 5
    ss_dwell_out_s: real[1] in 1 .. 100
    sun_axis: vec3[1] in -1 .. 1
    sa_done_deg: real[1] in 1 .. 60
    sa_done_hold_s: real[1] in 1 .. 100
end

## The spin-up and Sun-spin guards (Standard Code modes.transitions) and the spin-sign flip.
## vectors: 64
fn spin_guards(st: Modes, mp: ModeParams, sun_ok: bool, sun: vec3[1] in -1 .. 1, dt: real[1] in 0.05 .. 1) -> s: Modes
    s = st
    let d = pi/180.0
    let wz = s.w_est[2]
    let wp = sqrt(s.w_est[0]*s.w_est[0] + s.w_est[1]*s.w_est[1])
    if norm(s.w_est) > mp.ss_omega_max_dps*d
        s = modes_enter(s, 0)
    elif s.mode == 5
        let conv = |wz - s.sigma*mp.ss_spin_dps*d| < mp.ss_z_in_dps*d and wp < mp.ss_perp_in_dps*d
        if conv and sun_ok
            s.sz_sum = s.sz_sum + sun[2]
            s.sz_n = s.sz_n + 1
        end
        if s.t - s.sz_t0 >= mp.ss_t_check_s and s.sz_n > 0 and s.sz_sum/s.sz_n > mp.ss_sun_min
            s.sigma = -s.sigma
            s.sz_sum = 0
            s.sz_n = 0
            s.sz_t0 = s.t
        end
        let ok = conv and sun_ok and sun[2] < 0
        if ok
            s.hold = s.hold + dt
        else
            s.hold = 0
        end
        if s.hold >= mp.ss_dwell_in_s
            s = modes_enter(s, 6)
        end
    else
        let bad = |wz| < mp.ss_omega_exit_dps*d or wp > mp.ss_perp_out_dps*d
        if bad
            s.hold = s.hold + dt
        else
            s.hold = 0
        end
        if s.hold >= mp.ss_dwell_out_s
            s = modes_enter(s, 5)
        end
    end
end

## The transitions of one tick (after safe mode): the detumble exit, the spin guards, the
## gyro-propagated Sun vector of the acquisition laws, the end of the rotor Sun acquisition.
## vectors: 96
fn modes_step(st: Modes, mp: ModeParams, zw: vec3[1] in -0.1 .. 0.1, sun_ok: bool, sun: vec3[1] in -1 .. 1, dt: real[1] in 0.05 .. 1) -> s: Modes
    s = st
    if (s.mode == 0 or s.mode == 7) and mp.auto_next != 255 and band(s.faults, bor(256, 512)) == 0
        if norm(zw) < mp.detumble_exit
            s.hold = s.hold + dt
        else
            s.hold = 0
        end
        if s.hold >= mp.detumble_hold_s
            s = modes_enter(s, mp.auto_next)
        end
    end
    if (s.mode == 5 or s.mode == 6) and mp.ss_law != 2
        s = spin_guards(s, mp, sun_ok, sun, dt)
    end
    if s.mode == 5 or s.mode == 6 or s.mode == 8
        if sun_ok
            s.s_prop = sun
            s.s_prop_ok = true
        elif s.s_prop_ok
            let a = dcm(fromrotvec(s.w_est*dt))
            s.s_prop = unit(a*s.s_prop)
        end
    end
    if s.mode == 8 and mp.auto_next != 255
        let ok = sun_ok and acos(clamp(dot(sun, mp.sun_axis), -1, 1)) < mp.sa_done_deg*(pi/180.0) and s.ad_ok
        if ok
            s.acq_hold = s.acq_hold + dt
        else
            s.acq_hold = 0
        end
        if s.acq_hold >= mp.sa_done_hold_s
            s = modes_enter(s, mp.auto_next)
        end
    end
end

## Commanded changes: every schedule entry whose time has come, in order.
## vectors: 48
fn modes_schedule(st: Modes, mp: ModeParams) -> s: Modes
    s = st
    for k in 0 .. 8
        if s.sched_i < mp.n_sched and s.t >= mp.sched_t[s.sched_i]
            s = modes_enter(s, mp.sched_mode[s.sched_i])
            s.sched_i = s.sched_i + 1
        end
    end
end

## The nadir-family yaw flip with hysteresis h: turn 180 deg about the boresight when the power face
## would look away from the Sun. Returns the new flip.
fn yaw_flip(r: vec3[m] in -7.2e6 .. 7.2e6, v: vec3[m/s] in -7600 .. 7600, q_off: quat in -1 .. 1, sun_axis: vec3[1] in -1 .. 1, \
            roll_axis: vec3[1] in -1 .. 1, sun_eci: vec3[1] in -1 .. 1, flip: bool, hyst: real[1] in 0 .. 0.3) -> flip_out: bool
    let z: vec3[1] = 0
    let q, w, wd = guidance(0, r, v, 0, q_off, 0, 0, 1 [s], z, [0, 0, 0, 1], sun_axis, roll_axis, sun_eci, false)
    let sb = dcm(q)*unit(sun_eci)
    let a: vec3[1] = [0, 0, -1]
    if norm(sun_axis) > 0
        a = unit(sun_axis)
    end
    let d = dot(a, sb)
    flip_out = flip
    if d < -hyst
        flip_out = true
    elif d > hyst
        flip_out = false
    end
end
