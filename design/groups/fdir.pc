## fdir: every computing row of the group, as its nodes state it. Generated by tools/groupcode.py wire from the design's nodes; do not edit.
module fdir

## The rotor FDIR's own state (part of fsw_t).
record RotorFdir
    h_prev: real[N m s][8] in -0.05 .. 0.05
    h_prev_ok: bool
    cmd_r_prev: real[N m][8] in -0.01 .. 0.01
    fd_count: real[s][8] in 0 .. 2
    rot_failed: bool[8]
    faults: int in 0 .. 1023
    fw_e: real[N m s][8] in -0.01 .. 0.01
    fw_h0: real[N m s][8] in -0.05 .. 0.05
    fw_t0: real[s] in 860 .. 885
    fw_last: real[s] in 999.95 .. 1000
    fw_on: bool
    fw_bad: int[8] in 0 .. 3
end

## The rotor parameters the FDIR reads.
record RotorParams
    nr: int in 0 .. 8
    rot_tmax: real[N m][8] in 0.001 .. 0.01
    rot_hmax: real[N m s][8] in 0.01 .. 0.06
    rot_gi: int[8] in 0 .. 1
    rot_kind: int[8] in 0 .. 1
    fdir_s: real[s] in 0.1 .. 2
    fdir_win_s: real[s] in 100 .. 130
    fdir_h_frac: real[1] in 0.001 .. 0.02
end

## The rotor FDIR in the momentum-device states: a fixed rotor that does not follow its command is
## isolated. Instantaneous: the momentum rate against the command clipped to what the rotor can do;
## windowed (fluid loops only): the momentum change over fdir_win_s against the change commanded,
## missed in 2 windows in a row.
## vectors: 160
fn fdir_rotors(st: RotorFdir, rp: RotorParams, t: real[s] in 1000 .. 1000.2, dt: real[s] in 0.1 .. 0.2, zh: real[N m s][8] in -0.05 .. 0.05) -> s: RotorFdir
    s = st
    let nr = rp.nr
    if nr > 0 and s.h_prev_ok
        for i in 0 .. nr
            let tmax = rp.rot_tmax[i]
            let meas = (zh[i] - s.h_prev[i])/dt
            let expect = clamp(s.cmd_r_prev[i], -0.8*tmax, 0.8*tmax)
            let bad = |meas - expect| > 0.5*tmax and rp.rot_gi[i] == 0 and |expect| > 0.2*tmax and |zh[i]| < 0.9*rp.rot_hmax[i]
            s.fd_count[i] = if bad then s.fd_count[i] + dt else 0 [s]
            if s.fd_count[i] > rp.fdir_s and not s.rot_failed[i]
                s.rot_failed[i] = true
                s.faults = bor(s.faults, shl(1, i))
            end
        end
        if not s.fw_on or t - s.fw_last > 1.5*dt
            for i in 0 .. nr
                s.fw_e[i] = 0
                s.fw_h0[i] = zh[i]
            end
            s.fw_t0 = t
            s.fw_on = true
        else
            for i in 0 .. nr
                s.fw_e[i] = s.fw_e[i] + clamp(s.cmd_r_prev[i], -0.8*rp.rot_tmax[i], 0.8*rp.rot_tmax[i])*dt
            end
            if t - s.fw_t0 >= rp.fdir_win_s - 1e-9 [s]
                for i in 0 .. nr
                    let hmax = rp.rot_hmax[i]
                    let e = s.fw_e[i]
                    let m = zh[i] - s.fw_h0[i]
                    let skip = rp.rot_kind[i] != 1 or rp.rot_gi[i] != 0 or s.rot_failed[i] or |e| <= rp.fdir_h_frac*hmax \
                               or |zh[i]| >= 0.9*hmax or |s.fw_h0[i]| >= 0.9*hmax
                    if not skip
                        s.fw_bad[i] = if |m - e| > 0.5*|e| then s.fw_bad[i] + 1 else 0
                        if s.fw_bad[i] >= 2
                            s.rot_failed[i] = true
                            s.faults = bor(s.faults, shl(1, i))
                        end
                    end
                end
                for i in 0 .. nr
                    s.fw_e[i] = 0
                    s.fw_h0[i] = zh[i]
                end
                s.fw_t0 = t
            end
        end
        s.fw_last = t
    end
end

## Safe mode: a magnetometer (once seen) or a gyro silent more than 60 s sets its fault bit (8 and 9)
## and holds the spacecraft in magnetorquer detumble.
## vectors: 48
fn fdir_safe(st: Modes) -> s: Modes
    s = st
    let f = 0
    if s.mag_seen and s.mag_age > 60.0
        f = bor(f, 256)
    end
    if s.gyro_age > 60.0
        f = bor(f, 512)
    end
    s.faults = bor(band(s.faults, bxor(65535, bor(256, 512))), f)
    if f != 0 and s.mode != 0
        s = modes_enter(s, 0)
    end
end

## Sensor health after the drivers read: a field outside [0.25, 4] x the model is no reading; the
## last good field is held; the age of each sensor's last good sample.
fn fdir_sensors(mag_ok0: bool, b0: vec3[1] in -6e-5 .. 6e-5, bref_ok: bool, bref: vec3[1] in -6e-5 .. 6e-5, b_good0: vec3[1] in -6e-5 .. 6e-5, \
                mag_age0: real[1] in 0 .. 100, mag_seen0: bool, has_gyro: bool, gyro_ok: bool, w0: vec3[1] in -0.1 .. 0.1, \
                gyro_age0: real[1] in 0 .. 100, dt: real[1] in 0.05 .. 1) \
                -> (mag_ok: bool, b: vec3[1], w: vec3[1], b_good: vec3[1], mag_age: real[1], mag_seen: bool, gyro_age: real[1])
    mag_ok = mag_ok0
    b = b0
    w = w0
    b_good = b_good0
    mag_age = mag_age0
    mag_seen = mag_seen0
    gyro_age = gyro_age0
    if mag_ok and bref_ok
        let bn = norm(b)
        let rn = norm(bref)
        if not (bn > 0.25*rn and bn < 4.0*rn)
            mag_ok = false
        end
    end
    if mag_ok
        b_good = b
        mag_age = 0
        mag_seen = true
    else
        b = b_good
        mag_age = mag_age + dt
    end
    if not has_gyro or gyro_ok
        gyro_age = 0
    else
        gyro_age = gyro_age + dt
    end
    if not gyro_ok and not has_gyro
        w = 0
    end
end
