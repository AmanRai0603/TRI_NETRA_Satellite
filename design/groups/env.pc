## env: every computing row of the group, as its nodes state it. Generated by tools/groupcode.py wire from the design's nodes; do not edit.
module env

## Earth's gravitational parameter (EGM-96 / WGS-84, as the engine's orbit.rs).
const MU_E = 3.986004418e14 [m^3/s^2]

## The worst gravity-gradient torque: 3 mu/(2 r^3) |I_max - I_min| sin(2 theta), theta = 45 deg.
fn gravity_gradient_torque_worst(r: real[km] in 6500 .. 8500, i_max: real[kg m^2] in 0.01 .. 100, i_min: real[kg m^2] in 0.01 .. 100) -> tau: real[N m]
    tau = 3*MU_E/(2*r^3)*|i_max - i_min|*sin(2*45 [deg])
end

## The node's answer, tau_gg, as gravity_gradient_torque_worst gives it.
fn gd_0(r: real[km] in 6500 .. 8500, i_max: real[kg m^2] in 0.01 .. 100, i_min: real[kg m^2] in 0.01 .. 100) -> tau_gg: real[N m]
    tau_gg = gravity_gradient_torque_worst(r, i_max, i_min)
end

## The aerodynamic torque: tau = 1/2 rho v^2 C_D A c_pa.
fn aero_torque(rho: real[kg/m^3] in 1e-14 .. 1e-10, v: real[m/s] in 6000 .. 8000, c_d: real[1] in 2 .. 2.5, a_fr: real[m^2] in 0.01 .. 2, c_pa: real[m] in 0 .. 0.2) -> tau: real[N m]
    tau = 0.5*rho*v^2*c_d*a_fr*c_pa
end

## The node's answer, tau_a, as aero_torque gives it.
fn gd_1(rho: real[kg/m^3] in 1e-14 .. 1e-10, v: real[m/s] in 6000 .. 8000, c_d: real[1] in 2 .. 2.5, a_fr: real[m^2] in 0.01 .. 2, c_pa: real[m] in 0 .. 0.2) -> tau_a: real[N m]
    tau_a = aero_torque(rho, v, c_d, a_fr, c_pa)
end

## The solar-pressure torque at normal incidence: tau = P A (1 + q) c_ps.
fn solar_pressure_torque_at(p_srp: real[Pa] in 4e-6 .. 5e-6, a_sun: real[m^2] in 0.01 .. 2, q: real[1] in 0 .. 1, c_ps: real[m] in 0 .. 0.2) -> tau: real[N m]
    tau = p_srp*a_sun*(1 + q)*c_ps
end

## The node's answer, tau_s, as solar_pressure_torque_at gives it.
fn gd_2(p_srp: real[Pa] in 4e-6 .. 5e-6, a_sun: real[m^2] in 0.01 .. 2, q: real[1] in 0 .. 1, c_ps: real[m] in 0 .. 0.2) -> tau_s: real[N m]
    tau_s = solar_pressure_torque_at(p_srp, a_sun, q, c_ps)
end

## The magnetic torque of a residual dipole in a field: tau = D B. (base)
fn magnetic_torque(residual_dipole: real[A m^2] in 0.0001 .. 1, field: real[T] in 1e-6 .. 6e-5) -> tau: real[N m]
    tau = residual_dipole*field
end

## The node's answer, tau_m, as magnetic_torque gives it.
fn gd_3(residual_dipole: real[A m^2] in 0.0001 .. 1, field: real[T] in 1e-6 .. 6e-5) -> tau_m: real[N m]
    tau_m = magnetic_torque(residual_dipole, field)
end

## The worst-case sum of the four disturbance torques. (base)
fn total_disturbance_torque(aerodynamic: real[N m] in 0 .. 1e-3, gravity_gradient: real[N m] in 0 .. 1e-3, solar: real[N m] in 0 .. 1e-3, magnetic: real[N m] in 0 .. 1e-3) -> tau: real[N m]
    tau = gravity_gradient + aerodynamic + solar + magnetic
end

## The node's answer, tau_d, as total_disturbance_torque gives it.
fn gd_4(aerodynamic: real[N m] in 0 .. 1e-3, gravity_gradient: real[N m] in 0 .. 1e-3, solar: real[N m] in 0 .. 1e-3, magnetic: real[N m] in 0 .. 1e-3) -> tau_d: real[N m]
    tau_d = total_disturbance_torque(aerodynamic, gravity_gradient, solar, magnetic)
end

## The momentum a constant disturbance builds over one orbit: H = tau T.
fn secular_momentum_per_orbit(tau_d: real[N m] in 1e-8 .. 1e-4, t_orb: real[s] in 5000 .. 7000) -> h: real[N m s]
    h = tau_d*t_orb
end

## The node's answer, H_sec, as secular_momentum_per_orbit gives it.
fn gd_5(tau_d: real[N m] in 1e-8 .. 1e-4, t_orb: real[s] in 5000 .. 7000) -> H_sec: real[N m s]
    H_sec = secular_momentum_per_orbit(tau_d, t_orb)
end

## Earth's equatorial radius (WGS-84, as the engine's orbit.rs).
const R_E = 6378137 [m]

## The orbit radius at altitude h: r = R_E + h (spherical Earth).
fn radius(h: real[km] in 150 .. 2000) -> r: real[m]
    r = R_E + h
end

## The period of a circular orbit of radius r: T = 2 pi sqrt(r^3/mu).
fn circular_period(r: real[km] in 6500 .. 8500) -> t: real[s]
    t = 2*pi*sqrt(r^3/MU_E)
end

## The node's answer, T, as circular_period gives it.
fn m2_5(r: real[km] in 6500 .. 8500) -> T: real[s]
    T = circular_period(r)
end

## The mean motion of an orbit of period T: n = 2 pi / T.
fn mean_motion(t_orb: real[min] in 85 .. 130) -> n: real[rad/s]
    n = 2*pi/t_orb
end

## The degree-1 coefficients of the main field, IGRF-13 at 2020.0 (matlab_sils/data/igrf13coeffs.txt),
## until the igrf14 bundle lands (docs/ADCS_GAPS.md).
const IGRF_G10 = -29404.8 [nT]

const IGRF_G11 = -1450.9 [nT]

const IGRF_H11 = 4652.5 [nT]

## The dipole strength B0 = sqrt(g10^2 + g11^2 + h11^2) and its tilt from the spin axis.
fn dipole() -> (b0: real[T], tilt: real[rad])
    b0 = sqrt(IGRF_G10^2 + IGRF_G11^2 + IGRF_H11^2)
    tilt = acos(-IGRF_G10/b0)
end

## The dipole field at the magnetic equator at radius r: B_min = B0 (R_E/r)^3.
fn dipole_field_equator(r: real[km] in 6500 .. 8500) -> b_min: real[T]
    let b0, tilt = dipole()
    b_min = b0*(R_E/r)^3
end

## The node's answer, B_min, as dipole_field_equator gives it.
fn m3_0(r: real[km] in 6500 .. 8500) -> B_min: real[T]
    B_min = dipole_field_equator(r)
end

## The dipole field at magnetic latitude lambda_max: B_max = B0 (R_E/r)^3 sqrt(1 + 3 sin^2 lambda).
fn dipole_field_max(r: real[km] in 6500 .. 8500, lambda_max: real[deg] in 0 .. 90) -> b_max: real[T]
    let b0, tilt = dipole()
    b_max = b0*(R_E/r)^3*sqrt(1 + 3*sin(lambda_max)^2)
end

## The node's answer, B_max, as dipole_field_max gives it.
fn m3_1(r: real[km] in 6500 .. 8500, lambda_max: real[deg] in 0 .. 90) -> B_max: real[T]
    B_max = dipole_field_max(r, lambda_max)
end

## The highest magnetic latitude an orbit of inclination i reaches: min(90 deg, i' + tilt),
## i' = min(i, 180 deg - i).
fn max_magnetic_latitude(i: real[deg] in 0 .. 180) -> lambda_max: real[rad]
    let b0, tilt = dipole()
    let ip = min(i, 180 [deg] - i)
    lambda_max = min(90 [deg], ip + tilt)
end

## The static exponential atmosphere (Vallado 2013, table 8-4; the engine's atmos.rs):
## base altitude, base density, scale height.
table atmosphere(h: real[km]) -> (h0: real[km], rho0: real[kg/m^3], scale: real[km]) step
    0, 1.225, 7.249
    25, 3.899e-2, 6.349
    30, 1.774e-2, 6.682
    40, 3.972e-3, 7.554
    50, 1.057e-3, 8.382
    60, 3.206e-4, 7.714
    70, 8.770e-5, 6.549
    80, 1.905e-5, 5.799
    90, 3.396e-6, 5.382
    100, 5.297e-7, 5.877
    110, 9.661e-8, 7.263
    120, 2.438e-8, 9.473
    130, 8.484e-9, 12.636
    140, 3.845e-9, 16.149
    150, 2.070e-9, 22.523
    180, 5.464e-10, 29.740
    200, 2.789e-10, 37.105
    250, 7.248e-11, 45.546
    300, 2.418e-11, 53.628
    350, 9.518e-12, 53.298
    400, 3.725e-12, 58.515
    450, 1.585e-12, 60.828
    500, 6.967e-13, 63.822
    600, 1.454e-13, 71.835
    700, 3.614e-14, 88.667
    800, 1.170e-14, 124.64
    900, 5.245e-15, 181.05
    1000, 3.019e-15, 268.00
end

## The neutral density at altitude h: rho0 exp(-(h - h0)/H) in the table's band. The epoch does not
## enter yet: the solar-activity dependence waits on the nrlmsis2 bundle (docs/ADCS_GAPS.md).
fn density_at(h: real[km] in 150 .. 1000, t_epoch: real[yr] in 20 .. 40) -> rho: real[kg/m^3]
    let h0, rho0, scale = atmosphere(h)
    rho = rho0*exp(-(h - h0)/scale)
end

## The speed on a circular orbit of radius r: v = sqrt(mu/r).
fn circular_speed(r: real[km] in 6500 .. 8500) -> v: real[m/s]
    v = sqrt(MU_E/r)
end

## The Earth-Sun distance in AU at a time from J2000.0 (Vallado 2013, algorithm 29).
fn sun_distance_au(t_epoch: real[yr] in 20 .. 40) -> d: real[1]
    let tc = t_epoch/(36525 [day])
    let m = (357.5291092 + 35999.05034*tc)*1 [deg]
    d = 1.000140612 - 0.016708617*cos(m) - 0.000139589*cos(2*m)
end

## Total solar irradiance at 1 AU (Kopp & Lean 2011, 1360.8 +- 0.5 W/m^2). source: kopp2011
const F_SUN = 1360.8 [W/m^2]

## The speed of light (exact, SI).
const C_LIGHT = 299792458 [m/s]

## The Sun's radiation pressure at the Earth's distance: P = (F_sun/c) (1 AU/d)^2.
fn solar_pressure(t_epoch: real[yr] in 20 .. 40) -> p_srp: real[Pa]
    let d = sun_distance_au(t_epoch)
    p_srp = F_SUN/C_LIGHT/d^2
end

## The node's answer, P_srp, as solar_pressure gives it.
fn m3_5(t_epoch: real[yr] in 20 .. 40) -> P_srp: real[Pa]
    P_srp = solar_pressure(t_epoch)
end
