## act: every computing row of the group, as its nodes state it. Generated by tools/groupcode.py wire from the design's nodes; do not edit.
module act

## The axis of each of the nr rotors (columns of a 3 x 8): its nominal axis, turned about its
## gimbal (rot_gi = gimbal index + 1, 0 fixed) by the gimbal angle.
fn rotor_axes(nr: int in 0 .. 8, rot_a0: real[1][3][8] in -1 .. 1, rot_gi: int[8] in 0 .. 4, gim_axis: real[1][3][4] in -1 .. 1, \
              delta: vec4[1] in -3.1 .. 3.1) -> a: real[1][8][3]
    a = 0
    for i in 0 .. nr
        let a0 = rot_a0[i]
        if rot_gi[i] > 0
            let j = rot_gi[i] - 1
            let t0 = cross(gim_axis[j], a0)
            for k in 0 .. 3
                a[k][i] = cos(delta[j])*a0[k] + sin(delta[j])*t0[k]
            end
        else
            for k in 0 .. 3
                a[k][i] = a0[k]
            end
        end
    end
end

## The determinant by the first row.
fn det3(m: mat3[1] in -3 .. 3) -> d: real[1]
    d = m[0][0]*(m[1][1]*m[2][2] - m[1][2]*m[2][1]) - m[0][1]*(m[1][0]*m[2][2] - m[1][2]*m[2][0]) \
        + m[0][2]*(m[1][0]*m[2][1] - m[1][1]*m[2][0])
end

## The inverse by the adjugate; a singular matrix (|det| < 1e-300) gives zeros and ok = false.
fn inv3(m: mat3[1] in -3 .. 3) -> (r: mat3[1], ok: bool)
    let d = det3(m)
    ok = |d| >= 1e-300
    if ok
        r[0] = [(m[1][1]*m[2][2] - m[1][2]*m[2][1])/d, (m[0][2]*m[2][1] - m[0][1]*m[2][2])/d, (m[0][1]*m[1][2] - m[0][2]*m[1][1])/d]
        r[1] = [(m[1][2]*m[2][0] - m[1][0]*m[2][2])/d, (m[0][0]*m[2][2] - m[0][2]*m[2][0])/d, (m[0][2]*m[1][0] - m[0][0]*m[1][2])/d]
        r[2] = [(m[1][0]*m[2][1] - m[1][1]*m[2][0])/d, (m[0][1]*m[2][0] - m[0][0]*m[2][1])/d, (m[0][0]*m[1][1] - m[0][1]*m[1][0])/d]
    end
end

## Singularity-robust steering: gimbal rates (and, with wheels, rotor momentum rates) that give
## the torque tau, weighted away from the singular set, the gimbal rates held to gim_rate_max.
fn steer_sr(tau: vec3[1] in -0.01 .. 0.01, a: real[1][8][3] in -1 .. 1, h: real[1][8] in -0.05 .. 0.05, nr: int in 0 .. 8, ng: int in 0 .. 4, \
            rot_gi: int[8] in 0 .. 4, gim_axis: real[1][3][4] in -1 .. 1, gim_rate_max: real[1] in 0.1 .. 2, cmg_lam0: real[1] in 1e-6 .. 1e-2, \
            cmg_mu: real[1] in 1 .. 100, wheels: bool) -> (gdot: vec4[1], hdot: real[1][8])
    let jg: real[1][4][3] = 0
    let h0: real[1] = 0
    for i in 0 .. nr
        if rot_gi[i] > 0
            let j = rot_gi[i] - 1
            let c = cross(gim_axis[j], [a[0][i], a[1][i], a[2][i]])
            for k in 0 .. 3
                jg[k][j] = -h[i]*c[k]
            end
            if |h[i]| > h0
                h0 = |h[i]|
            end
        end
    end
    let m: mat3[1] = 0
    for i in 0 .. 3
        for j in 0 .. 3
            m[i][j] = 0
            for k in 0 .. ng
                m[i][j] = m[i][j] + jg[i][k]*jg[j][k]
            end
        end
    end
    if h0 < 1e-12
        h0 = 1e-12
    end
    let ms = det3(m)/(h0*h0*h0*h0*h0*h0)
    let n = if wheels then ng + nr else ng
    let jj: real[1][12][3] = 0
    for i in 0 .. 3
        for j in 0 .. ng
            jj[i][j] = jg[i][j]
        end
        if wheels
            for j in 0 .. nr
                jj[i][ng + j] = -a[i][j]
            end
        end
    end
    let w: real[1][12] = 0
    for j in 0 .. n
        w[j] = if j < ng then 1.0 else 0.01 + 2.0*exp(-10.0*ms)
    end
    let lam = cmg_lam0*exp(-cmg_mu*ms)
    for i in 0 .. 3
        for j in 0 .. 3
            m[i][j] = if i == j then lam else 0.0
            for k in 0 .. n
                m[i][j] = m[i][j] + jj[i][k]*w[k]*jj[j][k]
            end
        end
    end
    let mi, ok = inv3(m)
    let x = mi*tau
    let u: real[1][12] = 0
    for k in 0 .. n
        u[k] = w[k]*(jj[0][k]*x[0] + jj[1][k]*x[1] + jj[2][k]*x[2])
    end
    let s = 1.0
    gdot = 0
    for j in 0 .. ng
        gdot[j] = u[j]
        if |u[j]|/gim_rate_max > s
            s = |u[j]|/gim_rate_max
        end
    end
    for j in 0 .. ng
        gdot[j] = gdot[j]/s
    end
    hdot = 0
    for i in 0 .. nr
        hdot[i] = if wheels then u[ng + i]/s else 0.0
    end
end

## The momentum of a ring of bore d around an area S, fluid of density rho at speed v:
## H = 2 rho A v S, A = pi d^2/4.
fn ring_momentum(d: real[mm] in 1 .. 20, s: real[m^2] in 0.005 .. 0.5, rho: real[kg/m^3] in 1000 .. 13600, v: real[m/s] in 0.01 .. 2) -> h: real[N m s]
    let a = pi*d^2/4
    h = 2*rho*a*v*s
end

## The node's answer, H_ring, as ring_momentum gives it.
fn gf_6(d: real[mm] in 1 .. 20, s: real[m^2] in 0.005 .. 0.5, rho: real[kg/m^3] in 1000 .. 13600, v: real[m/s] in 0.01 .. 2) -> H_ring: real[N m s]
    H_ring = ring_momentum(d, s, rho, v)
end

## The viscous spin-down time constant of a channel: T = rho d^2/(32 mu).
fn spin_down_time(d: real[mm] in 1 .. 20, rho: real[kg/m^3] in 1000 .. 13600, mu: real[Pa s] in 0.0005 .. 0.005) -> t: real[s]
    t = rho*d^2/(32*mu)
end

## The node's answer, T_spin, as spin_down_time gives it.
fn gf_7(d: real[mm] in 1 .. 20, rho: real[kg/m^3] in 1000 .. 13600, mu: real[Pa s] in 0.0005 .. 0.005) -> T_spin: real[s]
    T_spin = spin_down_time(d, rho, mu)
end

## The power that holds a momentum against laminar friction: P = 2 pi mu L H^2/(rho^2 A^2 S^2).
fn holding_power_laminar(h: real[N m s] in 1e-4 .. 0.1, mu: real[Pa s] in 0.0005 .. 0.005, l: real[m] in 0.1 .. 3, rho: real[kg/m^3] in 1000 .. 13600, d: real[mm] in 1 .. 20, s: real[m^2] in 0.005 .. 0.5) -> p: real[W]
    let a = pi*d^2/4
    p = 2*pi*mu*l*h^2/(rho^2*a^2*s^2)
end

## The node's answer, P_hold, as holding_power_laminar gives it.
fn gf_8(h: real[N m s] in 1e-4 .. 0.1, mu: real[Pa s] in 0.0005 .. 0.005, l: real[m] in 0.1 .. 3, rho: real[kg/m^3] in 1000 .. 13600, d: real[mm] in 1 .. 20, s: real[m^2] in 0.005 .. 0.5) -> P_hold: real[W]
    P_hold = holding_power_laminar(h, mu, l, rho, d, s)
end

## The pump pressure that gives a torque: dp = tau L/(2 S A), A = pi d^2/4.
fn pump_pressure_for_torque(tau: real[N m] in 1e-6 .. 0.01, l: real[m] in 0.1 .. 3, s: real[m^2] in 0.005 .. 0.5, d: real[mm] in 1 .. 20) -> dp: real[Pa]
    let a = pi*d^2/4
    dp = tau*l/(2*s*a)
end

## The dipole that rejects a disturbance torque in the weakest field: m = tau/B_min.
fn dipole_to_reject(tau_d: real[N m] in 1e-8 .. 1e-4, b_min: real[T] in 1e-6 .. 6e-5) -> m: real[A m^2]
    m = tau_d/b_min
end

## The node's answer, m_rej, as dipole_to_reject gives it.
fn gm_1(tau_d: real[N m] in 1e-8 .. 1e-4, b_min: real[T] in 1e-6 .. 6e-5) -> m_rej: real[A m^2]
    m_rej = dipole_to_reject(tau_d, b_min)
end

## The dipole that dumps a momentum within a time in a field: m = H/(B t). (base)
fn magnetorquer_dipole_required(momentum: real[N m s] in 1e-4 .. 1, field: real[T] in 1e-6 .. 6e-5, dump_time: real[s] in 60 .. 10000) -> m: real[A m^2]
    m = momentum/(field*dump_time)
end

## The node's answer, m_dump, as magnetorquer_dipole_required gives it.
fn gm_2(momentum: real[N m s] in 1e-4 .. 1, field: real[T] in 1e-6 .. 6e-5, dump_time: real[s] in 60 .. 10000) -> m_dump: real[A m^2]
    m_dump = magnetorquer_dipole_required(momentum, field, dump_time)
end

## The torque the coils give about the worst axis: m B_min min(n, 3)/3 (fewer than three coils
## leave axes without authority).
fn torque_authority(m_av: real[A m^2] in 0.01 .. 10, b_min: real[T] in 1e-6 .. 6e-5, n_mtq: int in 0 .. 6) -> tau: real[N m]
    tau = m_av*b_min*min(n_mtq, 3)/3
end

## The node's answer, tau_mtq, as torque_authority gives it.
fn gm_3(m_av: real[A m^2] in 0.01 .. 10, b_min: real[T] in 1e-6 .. 6e-5, n_mtq: int in 0 .. 6) -> tau_mtq: real[N m]
    tau_mtq = torque_authority(m_av, b_min, n_mtq)
end

## Standard gravity (CGPM 1901, exact).
const G0 = 9.80665 [m/s^2]

## The propellant of one slew by thrusters alone: impulse H/r to start and the same to stop,
## m = (2 H/r)/(Isp g0).
fn propellant_per_slew(h: real[N m s] in 0.01 .. 10, r: real[m] in 0.05 .. 2, isp: real[s] in 50 .. 300) -> m_p: real[kg]
    m_p = (2*h/r)/(isp*G0)
end

## Days in a Julian year.
const DAYS_PER_YEAR = 365.25

## The propellant of a year of slews: m_p n_day 365.25 when thrusters are fitted, else 0.
fn propellant_per_year(m_p: real[kg] in 1e-5 .. 0.1, n_day: real[1] in 0 .. 50, n_rcs: int in 0 .. 12) -> m_year: real[kg]
    if n_rcs > 0
        m_year = m_p*n_day*DAYS_PER_YEAR
    else
        m_year = 0
    end
end

## The peak momentum of a bang-bang slew: H = 2 I theta/T.
fn bang_bang_peak_momentum(i_max: real[kg m^2] in 0.01 .. 100, theta: real[deg] in 1 .. 180, t_slew: real[s] in 5 .. 600) -> h: real[N m s]
    h = 2*i_max*theta/t_slew
end

## The node's answer, H_slew, as bang_bang_peak_momentum gives it.
fn gw_3(i_max: real[kg m^2] in 0.01 .. 100, theta: real[deg] in 1 .. 180, t_slew: real[s] in 5 .. 600) -> H_slew: real[N m s]
    H_slew = bang_bang_peak_momentum(i_max, theta, t_slew)
end

## The peak torque of a bang-bang slew: tau = 4 I theta/T^2.
fn bang_bang_peak_torque(i_max: real[kg m^2] in 0.01 .. 100, theta: real[deg] in 1 .. 180, t_slew: real[s] in 5 .. 600) -> tau: real[N m]
    tau = 4*i_max*theta/t_slew^2
end

## The node's answer, tau_slew, as bang_bang_peak_torque gives it.
fn gw_4(i_max: real[kg m^2] in 0.01 .. 100, theta: real[deg] in 1 .. 180, t_slew: real[s] in 5 .. 600) -> tau_slew: real[N m]
    tau_slew = bang_bang_peak_torque(i_max, theta, t_slew)
end
