## pnt: every computing row of the group, as its nodes state it. Generated by tools/groupcode.py wire from the design's nodes; do not edit.
module pnt

## The root sum square of the five pointing-error terms (knowledge, control, alignment,
## thermal, jitter). (base)
fn pointing_error_rss(terms: real[rad][5] in 0 .. 0.1) -> ape: real[rad]
    ape = sqrt(dot(terms, terms))
end

## The node's answer, APE, as pointing_error_rss gives it.
fn gp_5(terms: real[rad][5] in 0 .. 0.1) -> APE: real[rad]
    APE = pointing_error_rss(terms)
end
