## What several groups' rows call alike, written once. Generated by tools/groupcode.py wire from the design's nodes; do not edit.
module shared

## The part of the flight software's state the mode manager reads and writes.
record Modes
    mode: int in 0 .. 10
    t: real[1] in 0 .. 3000
    t_mode: real[1] in 0 .. 3000
    hold: real[1] in 0 .. 120
    ho: bool
    ho_t: real[1] in 0 .. 100
    ad_ok: bool
    n_rej: int in 0 .. 10
    i_q: vec3[1] in -0.1 .. 0.1
    sz_sum: real[1] in -10 .. 10
    sz_n: int in 0 .. 30
    sz_t0: real[1] in 0 .. 3000
    sigma: real[1] in -1 .. 1
    s_prop: vec3[1] in -1 .. 1
    s_prop_ok: bool
    acq_hold: real[1] in 0 .. 120
    sched_i: int in 0 .. 8
    faults: int in 0 .. 1023
    w_est: vec3[1] in -0.3 .. 0.3
    mag_seen: bool
    mag_age: real[1] in 0 .. 120
    gyro_age: real[1] in 0 .. 120
end

## The quaternion of a rotation matrix: the largest of (trace, R11, R22, R33) picks the form, then
## it is made unit (no sign forced).
fn fromdcm(r: mat3[1] in -1 .. 1) -> q: quat
    let tr = r[0][0] + r[1][1] + r[2][2]
    let idx = 0
    let best = tr
    if r[0][0] > best
        best = r[0][0]
        idx = 1
    end
    if r[1][1] > best
        best = r[1][1]
        idx = 2
    end
    if r[2][2] > best
        idx = 3
    end
    let u: quat = 0
    if idx == 0
        u = [r[1][2] - r[2][1], r[2][0] - r[0][2], r[0][1] - r[1][0], 1 + tr]
    elif idx == 1
        u = [1 + 2*r[0][0] - tr, r[0][1] + r[1][0], r[0][2] + r[2][0], r[1][2] - r[2][1]]
    elif idx == 2
        u = [r[1][0] + r[0][1], 1 + 2*r[1][1] - tr, r[1][2] + r[2][1], r[2][0] - r[0][2]]
    else
        u = [r[2][0] + r[0][2], r[2][1] + r[1][2], 1 + 2*r[2][2] - tr, r[0][1] - r[1][0]]
    end
    q = qnorm(u)
end

## The quaternion of a rotation vector: [sin(|t|/2) t/|t|, cos(|t|/2)]; below 1e-12 rad
## [t/2, 1] made unit.
fn fromrotvec(th: vec3[1] in -3 .. 3) -> q: quat
    let a = norm(th)
    if a < 1e-12
        q = qnorm([th[0]/2, th[1]/2, th[2]/2, 1.0])
    else
        q = [sin(a/2)*th[0]/a, sin(a/2)*th[1]/a, sin(a/2)*th[2]/a, cos(a/2)]
    end
end

## Enter a controller state: the dwell timers reset, the integral cleared; the states that skip
## estimation (detumble, thruster detumble, spin-up, Sun spin) drop the attitude estimate; spin-up
## starts its spin-sign window.
fn modes_enter(st: Modes, mode: int in 0 .. 10) -> s: Modes
    s = st
    if mode == 5
        s.sz_sum = 0
        s.sz_n = 0
        s.sz_t0 = s.t
    end
    s.mode = mode
    s.t_mode = s.t
    s.hold = 0
    s.ho = false
    s.ho_t = 0
    if mode == 0 or mode == 7 or mode == 5 or mode == 6
        s.ad_ok = false
        s.n_rej = 0
    end
    s.i_q = 0
end

## The Hamilton product a b (scalar last).
fn qmult(a: quat in -1 .. 1, b: quat in -1 .. 1) -> r: quat
    r = [a[3]*b[0] + b[3]*a[0] + (a[1]*b[2] - a[2]*b[1]), \
         a[3]*b[1] + b[3]*a[1] + (a[2]*b[0] - a[0]*b[2]), \
         a[3]*b[2] + b[3]*a[2] + (a[0]*b[1] - a[1]*b[0]), \
         a[3]*b[3] - (a[0]*b[0] + a[1]*b[1] + a[2]*b[2])]
end

## q made unit; a zero quaternion becomes the identity.
fn qnorm(q: quat in -1 .. 1) -> r: quat
    let n = sqrt(q[0]*q[0] + q[1]*q[1] + q[2]*q[2] + q[3]*q[3])
    if n < 1e-30
        r = [0, 0, 0, 1]
    else
        r = [q[0]/n, q[1]/n, q[2]/n, q[3]/n]
    end
end

## The skew-symmetric matrix of a: skew(a) b = a x b.
fn skew(a: vec3[1] in -3 .. 3) -> s: mat3[1]
    s = [[0, -a[2], a[1]], [a[2], 0, -a[0]], [-a[1], a[0], 0]]
end
