## ctl: every computing row of the group, as its nodes state it. Generated by tools/groupcode.py wire from the design's nodes; do not edit.
module ctl

## The 2 per cent settling time of a second-order loop: t_s = 4/(zeta w_n).
fn settling_time_2pct(w_n: real[rad/s] in 0.005 .. 2, zeta: real[1] in 0.3 .. 1.5) -> t_s: real[s]
    t_s = 4/(zeta*w_n)
end
