## The rotors' telemetry as the engine flies it, transcribed from adcs-sim run.rs (sense: the momentum each momentum device
## reports and the angle of its gimbal, the CAN frames' values): each rotor's momentum plus act_rotor_tlm_noise times a
## normal draw, then, for a rotor on a gimbal, the gimbal's angle plus act_gimbal_tlm_noise times a normal draw, a rotor
## at a time from the run's telemetry stream. The two sigmas are act's stated values (the 1.0.0 code's; the test of the
## built-in nodes holds them equal).
## The developer's transcription (S7.8), unsigned.
module rotortlm

## The rotor momentum telemetry's noise, one sigma [N m s] (act_rotor_tlm_noise).
const ROTOR_TLM_NOISE = 1e-7
## The gimbal angle telemetry's noise, one sigma [rad] (act_gimbal_tlm_noise).
const GIMBAL_TLM_NOISE = 1e-5

## What the n rotors report: each one's momentum [N m s] from its true momentum h, and the angle [rad] of its gimbal gi
## (from 1; 0 none) from the gimbals' true angles d, drawn from tlm.
fn rotor_telemetry(n: int in 0 .. 8, h: real[1][DYN_NR] in -0.05 .. 0.05, d: real[1][DYN_NG] in -3 .. 3, \
                   gi: int[DYN_NR] in 0 .. 4, tlm: inout stream) -> (hm: real[1][DYN_NR], dm: real[1][DYN_NR])
    hm = 0
    dm = 0
    for i in 0 .. n
        let z = normal(tlm)
        hm[i] = h[i] + ROTOR_TLM_NOISE*z
        if gi[i] > 0
            let w = normal(tlm)
            dm[i] = d[gi[i] - 1] + GIMBAL_TLM_NOISE*w
        end
    end
end
