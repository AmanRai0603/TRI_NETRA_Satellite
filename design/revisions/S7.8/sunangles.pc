## A fine Sun sensor's angles from its currents, transcribed from adcs-sim-core comp.rs (sun_sensor::angles): the
## normalised differences of the four currents give the spot's displacement, tan(alpha) = (a/2) rx / h, likewise beta
## (exact while the spot covers the centre); valid when the total current exceeds the part's threshold.
## The developer's transcription (S7.8), unsigned.
module sunangles

## The Sun in the head's frame (unit) from the four currents i (++, -+, --, +-), and whether it is valid.
fn quad_angles(i: real[1][4] in -0.1 .. 1, p: SunHead) -> (s: real[1][3], ok: bool)
    let tot = i[0] + i[1] + i[2] + i[3]
    ok = tot > p.min_frac
    s = [0.0, 0.0, 1.0]
    if ok
        let rx = ((i[0] + i[3]) - (i[1] + i[2]))/tot
        let ry = ((i[0] + i[1]) - (i[2] + i[3]))/tot
        s = unit_or_zero([p.a/2.0*rx/p.h, p.a/2.0*ry/p.h, 1.0])
    end
end
