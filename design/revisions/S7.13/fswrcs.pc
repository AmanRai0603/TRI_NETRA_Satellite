## The thrusters as the flight software is told of them, transcribed from adcs-sim config.rs (rcs_params, sensor_params):
## the product's thruster couples (how many, each one's torque at full duty in the body [N m]), the minimum impulse bit
## [s] and the valve's resolution [s] (0 where the part leaves them unstated); none when the product carries no thrusters.
## The developer's transcription (S7.13), unsigned.
module fswrcs

## The thruster couples the flight software is loaded with (FSW_NC at most).
const FSW_NC = 6

## The product's nc couples as the flight software's parameters: nc, rcs_tau, rcs_mib, rcs_res.
fn fsw_thrusters(fitted: bool, nc: int in 0 .. 6, tau: real[1][3][FSW_NC] in -1 .. 1, mib: real[1] in 0 .. 0.1, \
                 res: real[1] in 0 .. 0.1) -> (n: int, rcs_tau: real[1][3][FSW_NC], rcs_mib: real[1], rcs_res: real[1])
    n = 0
    rcs_tau = 0
    rcs_mib = 0
    rcs_res = 0
    if fitted
        n = nc
        for c in 0 .. FSW_NC
            if c < nc
                for k in 0 .. 3
                    rcs_tau[c][k] = tau[c][k]
                end
            end
        end
        rcs_mib = mib
        rcs_res = res
    end
    if not isfinite(rcs_mib)
        rcs_mib = 0
    end
    if not isfinite(rcs_res)
        rcs_res = 0
    end
end
