## The magnetic control's parameters of the flight software, transcribed from adcs-sim config.rs (mtq_gains): the coils'
## dipole limit; the B-dot gain and the detumble's exit rate; the magnetic pointing's gains on one bandwidth wn [rad/s] and
## damping z for every law, so the laws compare on their structure: PD, the LQR's weights (its gain the toolbox's Riccati
## solve), the sliding mode's surface and gain, and the magnetorquer-only literature laws (Lovera and Astolfi 2004, Celani
## 2015, Avanzini 2021, Celani 2026's boresight law with its weak roll in nadir, TANGO's frozen Riccati gains, Bruni and
## Celani's scaling of the proportional and derivative gains by gp and gd). The principal inertia ii [kg m^2], the mean
## motion n [rad/s]. Plain numbers in SI; degrees where the scenario states degrees.
## The developer's transcription (S7.13), unsigned.
module fswmtq

## The coils' dipole limit [A m^2] the flight software allocates against: the product's coils' m_max, or 1 when it carries none.
fn fsw_coil_limit(fitted: bool, m_max: real[1] in 0 .. 10) -> m: real[1]
    m = if fitted then m_max else 1.0
end

## The B-dot gain [A m^2 s]: scale 2 n (1 + sin i) J_min (Avanzini and Giulietti 2012), i the inclination [deg], J_min the
## smallest principal inertia, scale the scenario's (fsw_tune_bdot_gain_scale when it states none).
fn fsw_bdot_gain(scale: real[1] in 0.1 .. 10, n: real[1] in 0.0008 .. 0.0012, inc_deg: real[1] in 0 .. 180, \
                 ii: vec3[1] in 0.001 .. 1) -> k: real[1]
    let jmin = min(min(ii[0], ii[1]), ii[2])
    k = scale*2.0*n*(1.0 + sin(inc_deg*pi/180.0))*jmin
end

## A rate [rad/s] from the degrees per second a scenario states it in (the detumble's exit rate, detumble_exit).
fn fsw_rate_rad(deg_s: real[1] in 0 .. 10) -> w: real[1]
    w = deg_s*pi/180.0
end

## The magnetic pointing's PD gains on each principal axis: K_p = I wn^2, K_d = 2 z I wn, no integral.
fn fsw_mtq_pd(ii: vec3[1] in 0.001 .. 1, wn: real[1] in 0.001 .. 0.05, z: real[1] in 0.3 .. 3) \
              -> (kp: vec3[1], kd: vec3[1], ki: vec3[1])
    kp = 0
    kd = 0
    ki = 0
    for ax in 0 .. 3
        kp[ax] = ii[ax]*wn*wn
        kd[ax] = 2.0*z*ii[ax]*wn
    end
end

## The weights of the magnetic pointing's LQR on one axis of inertia i: the chain of the attitude error's integral, the
## error and the rate (A = [0 1 0; 0 0 1; 0 0 0], B = [0; 0; b], b = 1/i), Q = diag(1e-12, 1/th^2, 1/(wn th)^2) and
## R = 1/(i wn^2 th)^2 for an error of th = 0.05 rad, and the bandwidth p0 = wn the Riccati solve starts its pole placement
## from. Its gain is the toolbox's Riccati solve of them (Kleinman's iteration, adcs-sim lqr.rs chain3).
fn fsw_mtq_lqr_weights(i: real[1] in 0.001 .. 1, wn: real[1] in 0.001 .. 0.05) -> (b: real[1], q: vec3[1], r: real[1], p0: real[1])
    let th = 0.05
    q = [1e-12, 1.0/(th*th), 1.0/((wn*th)*(wn*th))]
    r = 1.0/((i*wn*wn*th)*(i*wn*wn*th))
    b = 1.0/i
    p0 = wn
end

## The magnetic sliding mode: its surface's slope lambda = wn/(2 z) 2 and its gain Gs = 2 z wn phi on each axis, phi the
## boundary layer (fsw_param_mtq_phi).
fn fsw_mtq_smc(wn: real[1] in 0.001 .. 0.05, z: real[1] in 0.3 .. 3, phi: real[1] in 1e-5 .. 1e-2) -> (lambda: real[1], gs: vec3[1])
    lambda = wn/(2.0*z)*2.0
    let g = 2.0*z*wn*phi
    gs = [g, g, g]
end

## The magnetorquer-only literature laws' gains, torque-level on the common bandwidth: k_p = gp J_m wn^2/eps^2 and the
## derivative gain gd 2 z wn/eps (Lovera and Astolfi multiply the rate by J; law 4) or gd 2 z J_m wn/eps (Celani does not),
## J_m the mean principal inertia, eps the averaging laws' time scale (fsw_param_mtq_eps); Avanzini 2021's k = gd (k/n) n
## (below 0.5 (1 + 2 sin xi_m) n; the paper flies 0.84 n) and its pitch-correction rate gp lambda; Celani 2026's boresight
## gains gp J_m wn^2 and gd 2 z J_m wn.
fn fsw_mtq_literature(law: int in 0 .. 8, ii: vec3[1] in 0.001 .. 1, wn: real[1] in 0.001 .. 0.05, z: real[1] in 0.3 .. 3, \
                      eps: real[1] in 1e-4 .. 1e-2, gp: real[1] in 0.1 .. 3, gd: real[1] in 0.1 .. 3, k_over_n: real[1] in 0.1 .. 2, \
                      lam: real[1] in 0.01 .. 0.5, n: real[1] in 0.0008 .. 0.0012) \
                      -> (k1: real[1], k2: real[1], k16: real[1], lam16: real[1], sb_kp: real[1], sb_kd: real[1])
    let jm = (ii[0] + ii[1] + ii[2])/3.0
    k1 = gp*jm*wn*wn/(eps*eps)
    if law == 4
        k2 = gd*2.0*z*wn/eps
    else
        k2 = gd*2.0*z*jm*wn/eps
    end
    k16 = gd*k_over_n*n
    lam16 = gp*lam
    sb_kp = gp*jm*wn*wn
    sb_kd = gd*2.0*z*jm*wn
end

## Celani 2026's weak roll about the payload axis in the nadir state, so the power face is held: its own PD on the
## boresight's inertia J_e = e'J e, at roll_wn_orbits orbit rates (wr = roll_wn_orbits n) and damping roll_zeta, scaled by
## roll_gain: k_roll = roll_gain J_e wr^2, k_droll = 2 roll_zeta J_e wr. (A bare share of the boresight gain is not enough:
## at the tuned rate gain the loop's Floquet multiplier grows to 4 an orbit, docs/MTQ_LITERATURE.md.)
fn fsw_mtq_roll(e: vec3[1] in -1 .. 1, j: mat3[1] in 0.001 .. 1, n: real[1] in 0.0008 .. 0.0012, roll_wn_orbits: real[1] in 0.5 .. 10, \
                roll_zeta: real[1] in 0.1 .. 3, roll_gain: real[1] in 0.1 .. 3) -> (kroll: real[1], kdroll: real[1])
    let je = e[0]*(j[0][0]*e[0] + j[0][1]*e[1] + j[0][2]*e[2]) + e[1]*(j[1][0]*e[0] + j[1][1]*e[1] + j[1][2]*e[2]) \
             + e[2]*(j[2][0]*e[0] + j[2][1]*e[1] + j[2][2]*e[2])
    let wr = roll_wn_orbits*n
    kroll = roll_gain*je*wr*wr
    kdroll = 2.0*roll_zeta*je*wr
end

## The roll term runs only once the boresight is within roll_gate_deg [deg] of its reference: the gate's cosine.
fn fsw_roll_gate(roll_gate_deg: real[1] in 0 .. 90) -> c: real[1]
    c = cos(roll_gate_deg*pi/180.0)
end

## TANGO's frozen Riccati gains: P from the CARE with the orbit-averaged B_u R^-1 B_u^T. An isotropic field average gives
## E[Gamma D Gamma]_ii = (7/15) D_i + tr(D)/15, D = J^-2 (the double integrator's CARE on each axis); Q is chosen (inverse
## LQR) so the average axis gets the common bandwidth wn and damping z, and each axis the gain its averaged authority calls
## for, R = 1 (the paper's Q and R are unpublished): the gains on the attitude error P21/R and on the rate error P22/R,
## scaled by gp and gd, on the diagonal.
fn fsw_mtq_tango(ii: vec3[1] in 0.001 .. 1, wn: real[1] in 0.001 .. 0.05, z: real[1] in 0.3 .. 3, gp: real[1] in 0.1 .. 3, \
                 gd: real[1] in 0.1 .. 3) -> (pth: mat3[1], pw: mat3[1])
    let r = 1.0
    let jm = (ii[0] + ii[1] + ii[2])/3.0
    let d: vec3[1] = [1.0/(ii[0]*ii[0]), 1.0/(ii[1]*ii[1]), 1.0/(ii[2]*ii[2])]
    let trd = d[0] + d[1] + d[2]
    let mi: vec3[1] = 0
    for ax in 0 .. 3
        mi[ax] = ((7.0/15.0)*d[ax] + trd/15.0)/r
    end
    let mref = (mi[0] + mi[1] + mi[2])/3.0
    let qt = mref*(jm*wn*wn*r)^2
    let qw0 = mref*(2.0*z*jm*wn*r)^2 - 2.0*sqrt(qt/mref)
    let qw = if qw0 > 0.0 then qw0 else 0.0
    pth = 0
    pw = 0
    for ax in 0 .. 3
        let p12 = sqrt(qt/mi[ax])
        let p22 = sqrt((qw + 2.0*p12)/mi[ax])
        pth[ax][ax] = gp*p12/r
        pw[ax][ax] = gd*p22/r
    end
end
