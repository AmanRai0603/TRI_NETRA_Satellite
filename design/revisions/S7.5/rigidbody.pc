## The attitude dynamics of the body with its momentum devices and a flexible mode, transcribed from adcs-sim-core
## plant.rs (State, deriv; la::kin; the twin's asils.plant.deriv): Euler's equations with the rotors' stored momentum,
## J wdot = tau_ext - hdot_rotors - w x (J w + h_rotors) (Wie 2008, Space Vehicle Dynamics and Control, eq. 7.47;
## Hughes 1986, chapter 3), the mode's terms when it is on (env's flexmode), the kinematics qdot = 1/2 q (x) [w; 0]
## (scalar last), and the rotors' momenta and gimbal angles changing at their commanded rates. The rate of the state the
## engine's integrator (code: RK4 with the inputs held) steps. Plain numbers in SI.
## The developer's transcription (S7.5), unsigned.
module rigidbody

## The plant's state: attitude (inertial to body, scalar last), body rate [rad/s], rotor momenta [N m s], gimbal angles
## [rad], and the flexible mode's coordinate and rate (zero on a rigid body).
record PlantState
    q: quat
    w: vec3[1]
    h: real[1][DYN_NR]
    d: real[1][DYN_NG]
    eta: real[1]
    etad: real[1]
end

## The kinematics: qdot = 1/2 q (x) [w; 0] (scalar last).
fn quat_rate(q: quat in -1 .. 1, w: vec3[1] in -1 .. 1) -> qd: quat
    qd = [0.5*(q[3]*w[0] + q[1]*w[2] - q[2]*w[1]), \
          0.5*(q[3]*w[1] - q[0]*w[2] + q[2]*w[0]), \
          0.5*(q[3]*w[2] + q[0]*w[1] - q[1]*w[0]), \
          0.5*(-q[0]*w[0] - q[1]*w[1] - q[2]*w[2])]
end

## The state's rate under the external torque tau_ext [N m] (body), the rotors' torques tau_r [N m] along their axes and
## the gimbal rates gdot [rad/s]; inertia [kg m^2] and its inverse iinv, minv the inverse of the reduced inertia (iinv
## when the mode is off), m the rotors' geometry and f the flexible mode.
fn plant_deriv(x: PlantState, inertia: mat3[1] in 0.001 .. 1, iinv: mat3[1] in -1000 .. 1000, minv: mat3[1] in -1000 .. 1000, \
               m: RotorGeometry, f: Flex, tau_ext: vec3[1] in -0.01 .. 0.01, tau_r: real[1][DYN_NR] in -0.01 .. 0.01, \
               gdot: real[1][DYN_NG] in -1 .. 1) -> xd: PlantState
    let w = x.w
    let hr: vec3[1] = [0, 0, 0]
    let hd: vec3[1] = [0, 0, 0]
    for ir in 0 .. m.nr
        let a: vec3[1] = m.a0[ir]
        let jg = m.gi[ir]
        if jg > 0
            let dj = x.d[jg - 1]
            let c = cos(dj)
            let s = sin(dj)
            for k1 in 0 .. 3
                a[k1] = c*m.a0[ir][k1] + s*m.t0[ir][k1]
                let ta = -s*m.a0[ir][k1] + c*m.t0[ir][k1]
                hd[k1] = hd[k1] + x.h[ir]*gdot[jg - 1]*ta
            end
        end
        for k2 in 0 .. 3
            hr[k2] = hr[k2] + a[k2]*x.h[ir]
            hd[k2] = hd[k2] + a[k2]*tau_r[ir]
        end
    end
    let ht: vec3[1] = [0, 0, 0]
    if f.on
        ht = inertia*w + hr + f.delta*x.etad
    else
        ht = inertia*w + hr
    end
    let g = cross(w, ht)
    xd = PlantState()
    xd.q = quat_rate(x.q, w)
    if f.on
        let pull = flex_pull(f, x.eta, x.etad)
        let rhs: vec3[1] = [tau_ext[0] - hd[0] - g[0] + f.delta[0]*pull, tau_ext[1] - hd[1] - g[1] + f.delta[1]*pull, \
                            tau_ext[2] - hd[2] - g[2] + f.delta[2]*pull]
        let wd = minv*rhs
        xd.w = wd
        xd.eta = x.etad
        xd.etad = -pull - dot(f.delta, wd)
    else
        let rhs0: vec3[1] = [tau_ext[0] - hd[0] - g[0], tau_ext[1] - hd[1] - g[1], tau_ext[2] - hd[2] - g[2]]
        xd.w = iinv*rhs0
    end
    let hdot: real[1][DYN_NR] = 0
    for ih in 0 .. m.nr
        hdot[ih] = tau_r[ih]
    end
    let ddot: real[1][DYN_NG] = 0
    for jd in 0 .. m.ng
        ddot[jd] = gdot[jd]
    end
    xd.h = hdot
    xd.d = ddot
end
