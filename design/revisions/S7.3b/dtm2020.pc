## DTM2020 operational (F10.7 and Kp), transcribed from adcs-pop atmos/dtm2020.rs, the port of the Octave POP's
## density_models/dtm2020/operational (DTM2020_F107_coeffs_init, dtm3, gldtm, dtm2020_oper_density) and the adapter
## +atmos/dtm2020.m, over env's DTM2020 coefficient tables; with the Bates temperature profile and the diffusive
## integration of the six species that the research model (dtm2020res) shares. Bruinsma and Boniface (2021), "The
## operational and research DTM-2020 thermosphere models", J. Space Weather Space Clim. 11, 47. Every power the code
## took through C's pow (Octave's x^y) is pow here, every sum in the code's order.
## The developer's transcription (S7.3b), unsigned.
module dtm2020

## Which coefficient set: the operational (F10.7, Kp) or the research (F30, ap60) one.
choice DtmSet = operational, research

## The Earth's radius [km], surface gravity [cm/s^2], gas constant (cgs) and lower boundary [km] of dtm3 and dtm5.
const DTM_RE = 6356.77
const DTM_GSURF = 980.665
const DTM_RGAS = 831.4
const DTM_ZLB0 = 120.0

## The geographic Legendre functions of dtm3 and dtm5 (plg), with the geomagnetic ones.
record Plg
    p10: real[1]
    p20: real[1]
    p30: real[1]
    p40: real[1]
    p50: real[1]
    p60: real[1]
    p11: real[1]
    p21: real[1]
    p31: real[1]
    p41: real[1]
    p51: real[1]
    p22: real[1]
    p32: real[1]
    p42: real[1]
    p52: real[1]
    p62: real[1]
    p33: real[1]
    p10mg: real[1]
    p20mg: real[1]
    p30mg: real[1]
    p40mg: real[1]
    p50mg: real[1]
    p60mg: real[1]
    p11mg: real[1]
    p22mg: real[1]
    p31mg: real[1]
end

## The local-time harmonics (hloc).
record Hloc
    ch: real[1]
    sh: real[1]
    c2h: real[1]
    s2h: real[1]
    c3h: real[1]
    s3h: real[1]
end

## What dtm3 and dtm5 give: the temperature at the altitude and the exospheric one [K], the total and partial densities
## [g/cm^3] (H, He, O, N2, O2, N) and the mean molecular mass [amu].
record DtmRaw
    tz: real[1]
    tinf: real[1]
    ro: real[1]
    d: real[1][6]
    wmm: real[1]
end

## What dtm2020_oper_density and dtm2020_density give: the density [g/cm^3 and kg/m^3], the temperatures [K], the
## number densities [1/cm^3] and partial densities [g/cm^3] of H, He, O, N2, O2, N, the mean molecular mass [amu].
record DtmDensity
    rho_gcm3: real[1]
    rho_kgm3: real[1]
    t_k: real[1]
    tinf_k: real[1]
    n_cm3: real[1][6]
    rho_species: real[1][6]
    mbar_amu: real[1]
end

## The particle masses [g] of H, He, O, N2, O2, N (vma).
fn dtm_vma() -> v: real[1][6]
    v = [1.6606e-24, 6.6423e-24, 26.569e-24, 46.4958e-24, 53.1381e-24, 23.2479e-24]
end

## Column j of a coefficient set (tt h he o az2 o2 az t0 tp), as the code's 1-based 96-term vector: a[0] unused.
fn dtm_column(set: DtmSet, j: int in 0 .. 8) -> a: real[1][97]
    a = 0
    for k in 1 .. 97
        if set == DtmSet.operational
            a[k] = DTM2020_OPER[k - 1][j]
        else
            a[k] = DTM2020_RESEARCH[k - 1][j]
        end
    end
end

## The geographic block of the Legendre functions, common to dtm3 and dtm5, at a latitude [rad].
fn plg_geographic(alat: real[1] in -1.6 .. 1.6) -> p: Plg
    let c = sin(alat)
    let c2 = pow(c, 2.0)
    let c4 = pow(c2, 2.0)
    let s = cos(alat)
    let s2 = pow(s, 2.0)
    p = Plg()
    p.p10 = c
    p.p20 = 1.5*c2 - 0.5
    p.p30 = c*(2.5*c2 - 1.5)
    p.p40 = 4.375*c4 - 3.75*c2 + 0.375
    p.p50 = c*(7.875*c4 - 8.75*c2 + 1.875)
    p.p60 = (5.5*c*p.p50 - 2.5*p.p40)/3.0
    p.p11 = s
    p.p21 = 3.0*c*s
    p.p31 = s*(7.5*c2 - 1.5)
    p.p41 = c*s*(17.5*c2 - 7.5)
    p.p51 = s*(39.375*c4 - 26.25*c2 + 1.875)
    p.p22 = 3.0*s2
    p.p32 = 15.0*c*s2
    p.p42 = s2*(52.5*c2 - 7.5)
    p.p52 = 3.0*c*p.p42 - 2.0*p.p32
    p.p62 = 2.75*c*p.p52 - 1.75*p.p42
    p.p33 = 15.0*s*s2
end

## The local-time harmonics at a local solar time [rad].
fn hloc_of(hl: real[1] in 0 .. 6.3) -> h: Hloc
    h = Hloc()
    h.ch = cos(hl)
    h.sh = sin(hl)
    h.c2h = pow(h.ch, 2.0) - pow(h.sh, 2.0)
    h.s2h = 2.0*h.ch*h.sh
    h.c3h = h.c2h*h.ch - h.s2h*h.sh
    h.s3h = h.s2h*h.ch + h.c2h*h.sh
end

## gldtm: the operational g(L) expansion of one constituent (gdel). akp = [Kp 3 h delayed, 0, mean Kp 24 h, 0];
## ff0 = 1 for a temperature, 0 for a density.
fn gldtm(f: real[1] in 60 .. 250, fbar: real[1] in 60 .. 250, akp: real[1][4] in 0 .. 9, day: real[1] in 1 .. 366, \
         a: real[1][97] in -1 .. 1, plg: Plg, hloc: Hloc, xlon: real[1] in -3.2 .. 3.2, ff0: real[1] in 0 .. 1) -> gdel: real[1]
    let da: real[1][97] = 0
    da[2] = plg.p20
    da[3] = plg.p40
    da[74] = plg.p10
    da[77] = plg.p30
    da[78] = plg.p50
    da[79] = plg.p60
    let fmfb1 = f - fbar
    let fbm150 = fbar - 150.0
    da[4] = fmfb1
    da[6] = fbm150
    da[5] = pow(da[4], 2.0)
    da[69] = pow(da[6], 2.0)
    da[82] = da[4]*plg.p10
    da[83] = da[4]*plg.p20
    da[84] = da[4]*plg.p30
    da[85] = da[6]*plg.p20
    da[86] = da[6]*plg.p30
    da[87] = da[6]*plg.p40
    let c2fi = 1.0 - pow(plg.p10mg, 2.0)
    let dkp = akp[0] + (a[62] + c2fi*a[63])*akp[1]
    let dakp = a[7] + a[8]*plg.p20mg + a[68]*plg.p40mg + 2.0*dkp*(a[60] + a[61]*plg.p20mg + a[75]*2.0*dkp*dkp)
    da[62] = dakp*akp[1]
    da[63] = da[62]*c2fi
    let dkpm = akp[2] + a[67]*akp[3]
    let dakpm = a[64] + a[65]*plg.p20mg + a[72]*plg.p40mg + 2.0*dkpm*(a[66] + a[73]*plg.p20mg + a[76]*2.0*dkpm*dkpm)
    da[67] = dakpm*akp[3]
    da[7] = dkp
    da[8] = plg.p20mg*dkp
    da[68] = plg.p40mg*dkp
    da[60] = pow(dkp, 2.0)
    da[61] = plg.p20mg*da[60]
    da[75] = pow(da[60], 2.0)
    da[64] = dkpm
    da[65] = plg.p20mg*dkpm
    da[72] = plg.p40mg*dkpm
    da[66] = pow(dkpm, 2.0)
    da[73] = plg.p20mg*da[66]
    da[76] = pow(da[66], 2.0)
    # the static part
    let f0 = a[4]*da[4] + a[5]*da[5] + a[6]*da[6] + a[69]*da[69] + a[82]*da[82] + a[83]*da[83] + a[84]*da[84] \
             + a[85]*da[85] + a[86]*da[86] + a[87]*da[87]
    let f1f = 1.0 + f0*ff0
    f0 = f0 + a[2]*da[2] + a[3]*da[3] + a[74]*da[74] + a[77]*da[77] + a[7]*da[7] + a[8]*da[8] + a[60]*da[60] \
         + a[61]*da[61] + a[68]*da[68] + a[64]*da[64] + a[65]*da[65] + a[66]*da[66] + a[72]*da[72] + a[73]*da[73] \
         + a[75]*da[75] + a[76]*da[76] + a[78]*da[78] + a[79]*da[79]
    # the seasonal terms
    let rot = 0.017214206
    let rot2 = 0.034428412
    da[9] = cos(rot*(day - a[11]))
    da[10] = plg.p20*da[9]
    da[12] = cos(rot2*(day - a[14]))
    da[13] = plg.p20*da[12]
    let coste = cos(rot*(day - a[18]))
    da[15] = plg.p10*coste
    da[16] = plg.p30*coste
    da[17] = da[6]*da[15]
    let cos2te = cos(rot2*(day - a[20]))
    da[19] = plg.p10*cos2te
    da[39] = plg.p30*cos2te
    da[59] = da[6]*da[19]
    # the diurnal, semi-diurnal and ter-diurnal terms
    da[21] = plg.p11*hloc.ch
    da[22] = plg.p31*hloc.ch
    da[23] = da[6]*da[21]
    da[24] = da[21]*coste
    da[25] = plg.p21*hloc.ch*coste
    da[26] = plg.p11*hloc.sh
    da[27] = plg.p31*hloc.sh
    da[28] = da[6]*da[26]
    da[29] = da[26]*coste
    da[30] = plg.p21*hloc.sh*coste
    da[94] = plg.p51*hloc.ch
    da[95] = plg.p51*hloc.sh
    da[31] = plg.p22*hloc.c2h
    da[37] = plg.p42*hloc.c2h
    da[32] = plg.p32*hloc.c2h*coste
    da[33] = plg.p22*hloc.s2h
    da[38] = plg.p42*hloc.s2h
    da[34] = plg.p32*hloc.s2h*coste
    da[88] = plg.p32*hloc.c2h
    da[89] = plg.p32*hloc.s2h
    da[90] = da[6]*da[31]
    da[91] = da[6]*da[33]
    da[92] = plg.p62*hloc.c2h
    da[93] = plg.p62*hloc.s2h
    da[35] = plg.p33*hloc.c3h
    da[36] = plg.p33*hloc.s3h
    # the periodic part
    let fp = a[9]*da[9] + a[10]*da[10] + a[12]*da[12] + a[13]*da[13] + a[15]*da[15] + a[16]*da[16] + a[17]*da[17] \
             + a[19]*da[19] + a[21]*da[21] + a[22]*da[22] + a[23]*da[23] + a[24]*da[24] + a[25]*da[25] + a[26]*da[26] \
             + a[27]*da[27] + a[28]*da[28] + a[29]*da[29] + a[30]*da[30] + a[31]*da[31] + a[32]*da[32] + a[33]*da[33] \
             + a[34]*da[34] + a[35]*da[35] + a[36]*da[36] + a[37]*da[37] + a[38]*da[38] + a[39]*da[39] + a[59]*da[59] \
             + a[88]*da[88] + a[89]*da[89] + a[90]*da[90] + a[91]*da[91] + a[92]*da[92] + a[93]*da[93] + a[94]*da[94] \
             + a[95]*da[95]
    # the storm-time coupling (geographic Legendre functions times dkp)
    da[40] = plg.p10*coste*dkp
    da[41] = plg.p30*coste*dkp
    da[42] = plg.p50*coste*dkp
    da[43] = plg.p11*hloc.ch*dkp
    da[44] = plg.p31*hloc.ch*dkp
    da[45] = plg.p51*hloc.ch*dkp
    da[46] = plg.p11*hloc.sh*dkp
    da[47] = plg.p31*hloc.sh*dkp
    da[48] = plg.p51*hloc.sh*dkp
    fp = fp + a[40]*da[40] + a[41]*da[41] + a[42]*da[42] + a[43]*da[43] + a[44]*da[44] + a[45]*da[45] + a[46]*da[46] \
         + a[47]*da[47] + a[48]*da[48]
    # the non-migrating tides
    let clfl = cos(xlon)
    let slfl = sin(xlon)
    da[49] = plg.p11*clfl
    da[50] = plg.p21*clfl
    da[51] = plg.p31*clfl
    da[52] = plg.p41*clfl
    da[53] = plg.p51*clfl
    da[54] = plg.p11*slfl
    da[55] = plg.p21*slfl
    da[56] = plg.p31*slfl
    da[57] = plg.p41*slfl
    da[58] = plg.p51*slfl
    fp = fp + a[49]*da[49] + a[50]*da[50] + a[51]*da[51] + a[52]*da[52] + a[53]*da[53] + a[54]*da[54] + a[55]*da[55] \
         + a[56]*da[56] + a[57]*da[57] + a[58]*da[58]
    gdel = f0 + fp*f1f
end

## The Bates temperature profile and the diffusive integration of the six species, shared by dtm3 and dtm5, given the
## nine gdel (tt, t0, tp, then H, He, O, N2, O2, N) and the altitude [km].
fn dtm_profile(set: DtmSet, gd_tt: real[1] in -0.5 .. 0.5, gd_t0: real[1] in -0.5 .. 0.5, gd_tp: real[1] in -0.5 .. 0.5, \
               gd_sp: real[1][6] in -2 .. 2, alti: real[1] in 120.5 .. 1500) -> o: DtmRaw
    let ma: real[1][6] = [1.0, 4.0, 16.0, 28.0, 32.0, 14.0]
    let alefa: real[1][6] = [-0.40, -0.38, 0.0, 0.0, 0.0, 0.0]
    let vma = dtm_vma()
    let tt = dtm_column(set, 0)
    let t0 = dtm_column(set, 7)
    let tp = dtm_column(set, 8)
    let zlb = DTM_ZLB0
    let tinf = tt[1]*(1.0 + gd_tt)
    let t120 = t0[1]*(1.0 + gd_t0)
    let tp120 = tp[1]*(1.0 + gd_tp)
    let sigma = tp120/(tinf - t120)
    let dzeta = (DTM_RE + zlb)/(DTM_RE + alti)
    let zeta = (alti - zlb)*dzeta
    let sigzeta = sigma*zeta
    let expsz = exp(-sigzeta)
    let tz = tinf - (tinf - t120)*expsz
    let dbase: real[1][6] = 0
    for i in 0 .. 6
        let sp = dtm_column(set, i + 1)
        dbase[i] = sp[1]*exp(gd_sp[i])
    end
    let glb = DTM_GSURF/pow(1.0 + zlb/DTM_RE, 2.0)
    glb = glb/(sigma*DTM_RGAS*tinf)
    let t120tz = t120/tz
    o = DtmRaw()
    let cc: real[1][6] = 0
    let ro: real[1] = 0
    for i in 0 .. 6
        let gamma = ma[i]*glb
        let upapg = 1.0 + alefa[i] + gamma
        let fz_i = pow(t120tz, upapg)*exp(-sigzeta*gamma)
        cc[i] = dbase[i]*fz_i
        o.d[i] = cc[i]*vma[i]
        ro = ro + o.d[i]
    end
    let sum_cc: real[1] = 0
    for i in 0 .. 6
        sum_cc = sum_cc + cc[i]
    end
    o.tz = tz
    o.tinf = tinf
    o.ro = ro
    o.wmm = ro/(vma[0]*sum_cc)
end

## The nine gdel of a coefficient set (tt, t0, tp, then the six species) by the operational expansion.
fn dtm3_gdel(f: real[1] in 60 .. 250, fbar: real[1] in 60 .. 250, akp: real[1][4] in 0 .. 9, day: real[1] in 1 .. 366, \
             plg: Plg, hloc: Hloc, xlon: real[1] in -3.2 .. 3.2) -> (gd_tt: real[1], gd_t0: real[1], gd_tp: real[1], gd: real[1][6])
    let ff0: real[1][6] = [0.0, 0.0, 1.0, 1.0, 1.0, 1.0]
    gd_tt = gldtm(f, fbar, akp, day, dtm_column(DtmSet.operational, 0), plg, hloc, xlon, 1.0)
    gd_t0 = gldtm(f, fbar, akp, day, dtm_column(DtmSet.operational, 7), plg, hloc, xlon, 1.0)
    gd_tp = gldtm(f, fbar, akp, day, dtm_column(DtmSet.operational, 8), plg, hloc, xlon, 1.0)
    gd = 0
    for i in 0 .. 6
        gd[i] = gldtm(f, fbar, akp, day, dtm_column(DtmSet.operational, i + 1), plg, hloc, xlon, ff0[i])
    end
end

## dtm3: the operational DTM2020 at day of year day, F10.7 of the day before f and its 81-day mean fbar [sfu], the Kp
## array akp, altitude alti [km] (above 120), local solar time hl [rad], latitude alat and longitude xlon [rad].
fn dtm3(day: real[1] in 1 .. 366, f: real[1] in 60 .. 250, fbar: real[1] in 60 .. 250, akp: real[1][4] in 0 .. 9, \
        alti: real[1] in 120.5 .. 1500, hl: real[1] in 0 .. 6.3, alat: real[1] in -1.6 .. 1.6, xlon: real[1] in -3.2 .. 3.2) -> o: DtmRaw
    let cpmg = 0.19081
    let spmg = 0.98163
    let xlmg = -1.2392
    let plg = plg_geographic(alat)
    let c = sin(alat)
    let s = cos(alat)
    # the geomagnetic latitude, dipole approximation
    let clmlmg = cos(xlon - xlmg)
    let sp = s*cpmg*clmlmg + c*spmg
    let cmg = sp
    let cmg2 = pow(cmg, 2.0)
    let cmg4 = pow(cmg2, 2.0)
    plg.p10mg = cmg
    plg.p20mg = 1.5*cmg2 - 0.5
    plg.p40mg = 4.375*cmg4 - 3.75*cmg2 + 0.375
    let hloc = hloc_of(hl)
    let gd_tt, gd_t0, gd_tp, gd = dtm3_gdel(f, fbar, akp, day, plg, hloc, xlon)
    o = dtm_profile(DtmSet.operational, gd_tt, gd_t0, gd_tp, gd, alti)
end

## The densities of dtm3 or dtm5 in the wrappers' form: number densities [1/cm^3] from the partial densities.
fn dtm_pack(r: DtmRaw) -> o: DtmDensity
    let vma = dtm_vma()
    o = DtmDensity()
    for i in 0 .. 6
        o.n_cm3[i] = r.d[i]/vma[i]
    end
    o.rho_gcm3 = r.ro
    o.rho_kgm3 = r.ro*1000.0
    o.t_k = r.tz
    o.tinf_k = r.tinf
    o.rho_species = r.d
    o.mbar_amu = r.wmm
end

## dtm2020_oper_density: the operational model at a geodetic altitude [km], latitude and longitude [deg], local solar
## time [h], day of year, F10.7 and its mean [sfu] and the Kp array; ok is false at or below the model's floor, 120 km.
fn oper_density(alt_km: real[1] in 120.5 .. 1500, lat_deg: real[1] in -90 .. 90, lon_deg: real[1] in -180 .. 360, \
                lst_hours: real[1] in 0 .. 24, doy: real[1] in 1 .. 366, f107: real[1] in 60 .. 250, \
                f107_bar: real[1] in 60 .. 250, akp: real[1][4] in 0 .. 9) -> (ok: bool, o: DtmDensity)
    o = DtmDensity()
    ok = alt_km > 120.0
    if ok
        let hl = lst_hours/24.0*2.0*pi
        let alat = deg2rad(lat_deg)
        let xlon = deg2rad(lon_deg)
        o = dtm_pack(dtm3(doy, f107, f107_bar, akp, alt_km, hl, alat, xlon))
    end
end
