## The engine's calendar and sidereal time, transcribed from adcs-sim-core time.rs (the twin's asils.util.jd, jd2utc
## and decyear) and the sources it cites: the Julian date of a Gregorian date and back (Vallado 2013, algorithms 14
## and 22), the decimal year, the Greenwich mean sidereal time (IAU 1982, Aoki et al. 1982) and the IAU 1976
## precession (Lieske et al. 1977), J2000 to the Earth-fixed frame with nutation and polar motion left out.
## Times are Julian dates (UTC, UT1 = UTC); angles rad. The developer's transcription (S7.3), unsigned.
module caltime

## TT - UTC [s] for the leap-second epoch 2017-2035 (TAI - UTC = 37 s, IERS Bulletin C; TT - TAI = 32.184 s).
const TT_MINUS_UTC_S = 69.184

## The Julian date of a UTC calendar date [Y M D h m s] (Vallado 2013, algorithm 14; valid 1901-2099).
fn jd_utc(u: real[1][6] in 0 .. 2100) -> j: real[1]
    let y = u[0]
    let m = u[1]
    let d = u[2]
    j = 367.0*y - floor(7.0*(y + floor((m + 9.0)/12.0))/4.0) + floor(275.0*m/9.0) + d + 1721013.5 + ((u[5]/60.0 + u[4])/60.0 + u[3])/24.0
end

## The UTC calendar date [Y M D h m s] of a Julian date (the inverse, Meeus's form).
fn utc_of_jd(j: real[1] in 2415386 .. 2488069) -> u: real[1][6]
    let z = floor(j + 0.5)
    let f = j + 0.5 - z
    let a = floor((z - 1867216.25)/36524.25)
    let aa = z + 1.0 + a - floor(a/4.0)
    let b = aa + 1524.0
    let c = floor((b - 122.1)/365.25)
    let d = floor(365.25*c)
    let e = floor((b - d)/30.6001)
    let day = b - d - floor(30.6001*e)
    let mon = if e < 14.0 then e - 1.0 else e - 13.0
    let yr = if mon > 2.0 then c - 4716.0 else c - 4715.0
    let s = f*86400.0
    let h = floor(s/3600.0)
    s = s - 3600.0*h
    let mi = floor(s/60.0)
    s = s - 60.0*mi
    u = [yr, mon, day, h, mi, s]
end

## The decimal year of a Julian date: its year plus the fraction of that year gone.
fn decimal_year(j: real[1] in 2415386 .. 2488069) -> y: real[1]
    let u = utc_of_jd(j)
    let j0 = jd_utc([u[0], 1.0, 1.0, 0.0, 0.0, 0.0])
    let j1 = jd_utc([u[0] + 1.0, 1.0, 1.0, 0.0, 0.0, 0.0])
    y = u[0] + (j - j0)/(j1 - j0)
end

## The Greenwich mean sidereal time [rad] (IAU 1982), with UT1 = UTC.
fn gmst_iau82(jd_ut1: real[1] in 2415386 .. 2488069) -> g: real[1]
    let t = (jd_ut1 - 2451545.0)/36525.0
    let gs = fmod(67310.54841 + (876600.0*3600.0 + 8640184.812866)*t + 0.093104*t*t - 6.2e-6*t*t*t, 86400.0)
    if gs < 0.0
        gs = gs + 86400.0
    end
    g = gs/240.0*(pi/180.0)
end

## J2000 to the mean equator and equinox of date (IAU 1976 precession): P = R3(-z) R2(theta) R3(-zeta).
fn precession_iau76(j: real[1] in 2415386 .. 2488069) -> p: mat3[1]
    let t = (j - 2451545.0)/36525.0
    let as_ = (pi/180.0)/3600.0
    let ze = (2306.2181*t + 0.30188*t*t + 0.017998*t*t*t)*as_
    let z = (2306.2181*t + 1.09468*t*t + 0.018203*t*t*t)*as_
    let th = (2004.3109*t - 0.42665*t*t - 0.041833*t*t*t)*as_
    let cz = cos(ze)
    let sz = sin(ze)
    let cc = cos(z)
    let sc = sin(z)
    let ct = cos(th)
    let st = sin(th)
    p = [[cc*ct*cz - sc*sz, -cc*ct*sz - sc*cz, -cc*st], [sc*ct*cz + cc*sz, -sc*ct*sz + cc*cz, -sc*st], [st*cz, -st*sz, ct]]
end

## J2000 to the Earth-fixed frame: the IAU 1976 precession to the mean equator of date, then GMST about z
## (nutation and polar motion left out).
fn eci_to_ecef(jd_ut1: real[1] in 2415386 .. 2488069) -> c: mat3[1]
    let g = gmst_iau82(jd_ut1)
    let r: mat3[1] = [[cos(g), sin(g), 0.0], [-sin(g), cos(g), 0.0], [0.0, 0.0, 1.0]]
    c = r*precession_iau76(jd_ut1)
end
