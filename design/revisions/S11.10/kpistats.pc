## How a metric takes its samples and its statistic, transcribed from adcs-sim metrics.rs (window, stat, time_to), the
## twin's asils.metrics.window and evaluate: the window of a run a metric looks at (all of it, its last orbit or half
## orbit, the pointing modes, or after a time), the statistic over the window's finite values (the largest, the root
## mean square, the mean, and the 95th and 99.73rd percentiles, the 3-sigma level of ECSS-E-ST-60-10C, as the value at
## rank ceil(q n) of the sorted values), and the first time a channel stays below a threshold for a hold time. The
## channels are buffers whose length is the run's (G16); times in seconds, plain numbers.
## The developer's transcription (S7.14b), unsigned. S11.10 (A7): the window 'eclipse' (the samples within a half width of each
## change of the shadow factor), and the S7.14b finding about 'pointing' stated at the window.
module kpistats

## The part of a run a metric looks at: every sample, the last orbit (a whole orbit: the sunlit half and the eclipse
## both), the last half orbit (one half only: a tracker blind in the other half is never scored, A7), the samples in a
## pointing mode (any mode but the first, detumble: the S7.14b finding is that this counts the Sun spin and the Sun
## acquisition modes as pointing too, so it is no window for a fine-pointing verdict), the samples from a time on, the
## samples within a half width of each entry into or exit from the shadow (the scenario's 'eclipse_s:<half width>').
choice MetricWindow = all, last_orbit, last_half_orbit, pointing, after_s, eclipse

## The statistic of a metric over its window: the largest, the root mean square, the mean, the 95th and the 99.73rd
## percentile; none (a statistic the metric does not know) gives nan.
choice MetricStat = max, rms, mean, p95, p9973, none

## The larger of a and b as the code's f64::max takes it: a value that is not a number left out, equal values the first.
fn kpi_max(a: real[1] in -10 .. 10, b: real[1] in -10 .. 10) -> c: real[1]
    if isnan(a)
        c = b
    else
        c = max(a, b)
    end
end

## The smaller of a and b as the code's f64::min takes it: a value that is not a number left out, equal values the
## first.
fn kpi_min(a: real[1] in -10 .. 10, b: real[1] in -10 .. 10) -> c: real[1]
    if isnan(a)
        c = b
    else
        c = min(a, b)
    end
end

## The samples of the window w of a run of n samples at times t [s] in modes mode, with the shadow factor nu (1 sunlit),
## its orbit's period per [s] (after_s: from the time after [s]; eclipse: within after [s] of a change of nu < 1, entry
## or exit): their indices, in order, in idx; how many.
## length: 32
fn kpi_window(w: MetricWindow, after: real[1] in 0 .. 100, t: inout real[1][*] in 0 .. 100, mode: inout int[*] in 0 .. 10, \
              nu: inout real[1][*] in 0 .. 1, n: int in 0 .. 32, per: real[1] in 1 .. 200, idx: inout int[*] in 0 .. 31) -> ni: int
    let te: real[1] = 0.0
    if n > 0
        te = t[n - 1]
    end
    ni = 0
    if w == MetricWindow.eclipse
        for j in 0 .. n
            idx[j] = 0
        end
        for j in 1 .. n
            let now = nu[j] < 1.0
            let before = nu[j - 1] < 1.0
            if (now and not before) or (before and not now)
                for i in 0 .. n
                    if t[i] - t[j] <= after and t[j] - t[i] <= after
                        idx[i] = 1
                    end
                end
            end
        end
        for j in 0 .. n
            if idx[j] == 1
                idx[ni] = j
                ni = ni + 1
            end
        end
    else
        for j in 0 .. n
            let inw = true
            if w == MetricWindow.last_orbit
                inw = t[j] >= te - per
            elif w == MetricWindow.last_half_orbit
                inw = t[j] >= te - per/2.0
            elif w == MetricWindow.pointing
                inw = mode[j] + 1 > 1
            elif w == MetricWindow.after_s
                inw = t[j] >= after
            end
            if inw
                idx[ni] = j
                ni = ni + 1
            end
        end
    end
end

## One pass of the merge sort: the runs of width wd of src[0..m] merged in pairs into dst, ascending, a tie to the
## earlier run.
## length: 64
fn kpi_merge(src: inout real[1][*] in -10 .. 10, dst: inout real[1][*] in -10 .. 10, m: int in 0 .. 64, wd: int in 1 .. 64) -> z: int
    z = 0
    let nb = div(m + 2*wd - 1, 2*wd)
    for bk in 0 .. nb
        let lo = bk*2*wd
        let mid = min(lo + wd, m)
        let hi = min(lo + 2*wd, m)
        let i = lo
        let j = mid
        for k in lo .. hi
            if i < mid and (j >= hi or not (src[j] < src[i]))
                dst[k] = src[i]
                i = i + 1
            else
                dst[k] = src[j]
                j = j + 1
            end
        end
    end
end

## x[0..m] in ascending order, equal values in the order given (the code's stable sort): a bottom-up merge sort (Knuth,
## The Art of Computer Programming 3, 5.2.4) over tmp. How many passes.
## length: 64
fn kpi_sort(x: inout real[1][*] in -10 .. 10, m: int in 0 .. 64, tmp: inout real[1][*] in -10 .. 10) -> passes: int
    passes = 0
    let wd = 1
    for it in 0 .. 62
        if wd < m
            if rem(passes, 2) == 0
                let z0 = kpi_merge(x, tmp, m, wd)
            else
                let z1 = kpi_merge(tmp, x, m, wd)
            end
            passes = passes + 1
            wd = 2*wd
        end
    end
    if rem(passes, 2) == 1
        for i in 0 .. m
            x[i] = tmp[i]
        end
    end
end

## The statistic st of the m values of w, every one finite (nan when there are none); a percentile sorts w in place,
## over tmp. The sums start at -0, as the code's sum does.
## length: 64
fn kpi_stat_of(w: inout real[1][*] in -10 .. 10, m: int in 0 .. 64, st: MetricStat, tmp: inout real[1][*] in -10 .. 10) -> v: real[1]
    v = nan
    if m > 0
        if st == MetricStat.max
            let acc = -1.7976931348623157e308
            for i in 0 .. m
                acc = max(acc, w[i])
            end
            v = acc
        elif st == MetricStat.rms
            let s: real[1] = -0.0
            for i in 0 .. m
                s = s + w[i]*w[i]
            end
            v = sqrt(s/real(m))
        elif st == MetricStat.mean
            let s2: real[1] = -0.0
            for i in 0 .. m
                s2 = s2 + w[i]
            end
            v = s2/real(m)
        elif st == MetricStat.p95 or st == MetricStat.p9973
            let q = 0.95
            if st == MetricStat.p9973
                q = 0.9973
            end
            let passes = kpi_sort(w, m, tmp)
            let k = int(ceil(q*real(m)))
            if k < 1
                k = 1
            end
            v = w[k - 1]
        end
    end
end

## The statistic st of the finite values among x[0..n] (copied into w; tmp the sort's).
## length: 64
fn kpi_statistic(x: inout real[1][*] in -10 .. 10, n: int in 0 .. 64, st: MetricStat, w: inout real[1][*] in -10 .. 10, \
                 tmp: inout real[1][*] in -10 .. 10) -> v: real[1]
    let m = 0
    for i in 0 .. n
        if isfinite(x[i])
            w[m] = x[i]
            m = m + 1
        end
    end
    v = kpi_stat_of(w, m, st, tmp)
end

## The statistic st of a channel ch over the window's samples idx[0..ni], its finite values (copied into w; tmp the
## sort's).
## length: 64
fn kpi_channel_stat(ch: inout real[1][*] in -10 .. 10, idx: inout int[*] in 0 .. 63, ni: int in 0 .. 64, st: MetricStat, \
                    w: inout real[1][*] in -10 .. 10, tmp: inout real[1][*] in -10 .. 10) -> v: real[1]
    let m = 0
    for i in 0 .. ni
        let x = ch[idx[i]]
        if isfinite(x)
            w[m] = x
            m = m + 1
        end
    end
    v = kpi_stat_of(w, m, st, tmp)
end

## The first time [s] at which the channel x[0..n] (at times t [s]) goes below thr and stays below it for hold [s] or
## more; nan if it never does.
## length: 64
fn kpi_time_to(t: inout real[1][*] in 0 .. 100, x: inout real[1][*] in 0 .. 2, n: int in 0 .. 64, thr: real[1] in 0 .. 2, \
               hold: real[1] in 0 .. 20) -> v: real[1]
    v = nan
    let found = false
    let start = 0
    let inrun = false
    for k in 0 .. n
        if not found
            if x[k] < thr
                if not inrun
                    start = k
                    inrun = true
                end
                let ends = k == n - 1
                if not ends
                    ends = not (x[k + 1] < thr)
                end
                if ends
                    if t[k] - t[start] >= hold
                        v = t[start]
                        found = true
                    end
                    inrun = false
                end
            else
                inrun = false
            end
        end
    end
end

## The first time [s] after t0 [s] at which the channel x[0..n] (at times t [s]) goes below thr and stays below it for
## hold [s] or more, counted from t0 (the samples from t0 on, in tt and xx); nan if it never does.
## length: 64
fn kpi_time_to_from(t: inout real[1][*] in 0 .. 100, x: inout real[1][*] in 0 .. 2, n: int in 0 .. 64, t0: real[1] in 0 .. 50, \
                    thr: real[1] in 0 .. 2, hold: real[1] in 0 .. 20, tt: inout real[1][*] in 0 .. 100, \
                    xx: inout real[1][*] in 0 .. 2) -> v: real[1]
    let m = 0
    for j in 0 .. n
        if t[j] >= t0
            tt[m] = t[j] - t0
            xx[m] = x[j]
            m = m + 1
        end
    end
    v = kpi_time_to(tt, xx, m, thr, hold)
end

## The verdict of a requirement that holds at a level (A1, DR-kpi-001). Of n runs, k are successes: their metric is finite and
## within the limit (a run with no finite value is a failure, never left out). With each run a success with the
## probability R, the count is binomial; the exact (Clopper-Pearson, 1934) one-sided bounds at the confidence g are the
## R at which the chance of k or more successes is 1 - g (the lower bound) and of k or fewer is 1 - g (the upper).
choice Verdict = pass, fail, not_demonstrated

## The chance that a count of successes among n runs is k or more (upper) or k or fewer (not upper) when each run is a
## success with the probability p, by the sum of the binomial terms in logarithms (the term of i from the term of i - 1).
## length: 64
fn kpi_binomial_tail(n: int in 0 .. 2000, k: int in 0 .. 2000, p: real[1] in 0 .. 1, upper: bool) -> t: real[1]
    t = 0.0
    if p <= 0.0
        if upper
            t = 1.0
            if k > 0
                t = 0.0
            end
        else
            t = 1.0
        end
    elif p >= 1.0
        if upper
            t = 1.0
        else
            t = 0.0
            if k >= n
                t = 1.0
            end
        end
    else
        let lp = log(p)
        let lq = log(1.0 - p)
        let lc: real[1] = 0.0
        for i in 0 .. n + 1
            if i > 0
                lc = lc + log(real(n - i + 1)) - log(real(i))
            end
            let inside = i <= k
            if upper
                inside = i >= k
            end
            if inside
                t = t + exp(lc + real(i)*lp + real(n - i)*lq)
            end
        end
        t = min(t, 1.0)
    end
end

## The lower bound of the probability R at confidence g, of k successes in n runs: 0 with none; g' ^ (1/n) with all, g' = 1 - g
## (0.05^(1/12) = 0.779 for 12 runs); else the R at which the chance of k or more is 1 - g, by bisection.
## length: 64
fn kpi_cp_lower(n: int in 0 .. 2000, k: int in 0 .. 2000, g: real[1] in 0.5 .. 0.999) -> r: real[1]
    r = 0.0
    if n > 0 and k >= n
        r = exp(log(1.0 - g)/real(n))
    elif k > 0
        let lo: real[1] = 0.0
        let hi: real[1] = 1.0
        for it in 0 .. 60
            let mid = 0.5*(lo + hi)
            if kpi_binomial_tail(n, k, mid, true) < 1.0 - g
                lo = mid
            else
                hi = mid
            end
        end
        r = 0.5*(lo + hi)
    end
end

## The upper bound of the probability R at confidence g: 1 with all successes; 1 - g' ^ (1/n) with none; else the R at which the
## chance of k or fewer is 1 - g, by bisection.
## length: 64
fn kpi_cp_upper(n: int in 0 .. 2000, k: int in 0 .. 2000, g: real[1] in 0.5 .. 0.999) -> r: real[1]
    r = 1.0
    if n > 0 and k <= 0
        r = 1.0 - exp(log(1.0 - g)/real(n))
    elif k < n
        let lo: real[1] = 0.0
        let hi: real[1] = 1.0
        for it in 0 .. 60
            let mid = 0.5*(lo + hi)
            if kpi_binomial_tail(n, k, mid, false) > 1.0 - g
                lo = mid
            else
                hi = mid
            end
        end
        r = 0.5*(lo + hi)
    end
end

## The verdict of k successes among n runs for a requirement at the level p (the probability a run must meet it with) at the
## confidence g, with the bounds it rests on: pass when the lower bound reaches p; fail when the upper bound is below p;
## else not demonstrated (R >= the lower bound at g). No runs is a fail. A requirement with no level (p = 0) is each run's:
## pass when every run succeeds, else fail, the bounds then the fraction itself.
## length: 64
fn kpi_confidence_verdict(n: int in 0 .. 2000, k: int in 0 .. 2000, p: real[1] in 0 .. 1, g: real[1] in 0.5 .. 0.999) -> (v: Verdict, lower: real[1], upper: real[1])
    v = Verdict.fail
    lower = 0.0
    upper = 0.0
    if n > 0
        if p <= 0.0
            lower = real(k)/real(n)
            upper = lower
            if k >= n
                v = Verdict.pass
            end
        else
            lower = kpi_cp_lower(n, k, g)
            upper = kpi_cp_upper(n, k, g)
            if lower >= p
                v = Verdict.pass
            elif upper < p
                v = Verdict.fail
            else
                v = Verdict.not_demonstrated
            end
        end
    end
end

## The Mann-Whitney U test of two samples a[0..na] and b[0..nb] (A2: do two simulators give the same distribution of a metric): a
## value that is not finite is left out. Mann and Whitney (1947), Ann. Math. Statist. 18:50; the normal approximation with the
## tie correction and the continuity correction as in Hollander and Wolfe, Nonparametric Statistical Methods, 2nd ed. (1999),
## 4.1: the rank of a value among the finite values of both is the number below it and half of one more than the number equal to it
## (the mid-rank); U1 is the first sample's rank sum less n1 (n1 + 1)/2, the statistic u the smaller of U1 and n1 n2 - U1; the
## variance n1 n2/12 ((n + 1) - sum(t^3 - t)/(n (n - 1))), over the groups of t equal values, n = n1 + n2; z = (|U1 - n1 n2/2| -
## 1/2)/sd (0 when the difference is no more than 1/2) and the two-sided p = erfc(z/sqrt 2) = 1 - erf(z/sqrt 2). With a side
## empty there is no test (u, z and p are nan); with every value tied (no variance) z is 0 and p is 1. The ranks are counted in
## pairs, so a sample of a few hundred is what it is for.
## length: 24
fn kpi_mann_whitney(a: inout real[1][*] in -1000 .. 1000, b: inout real[1][*] in -1000 .. 1000) -> (n1: int, n2: int, u: real[1], z: real[1], p: real[1])
    n1 = 0
    n2 = 0
    for i in 0 .. len(a)
        if isfinite(a[i])
            n1 = n1 + 1
        end
    end
    for i in 0 .. len(b)
        if isfinite(b[i])
            n2 = n2 + 1
        end
    end
    u = nan
    z = nan
    p = nan
    if n1 > 0 and n2 > 0
        let r1: real[1] = 0.0
        let ties: real[1] = 0.0
        for side in 0 .. 2
            let m = len(a)
            if side == 1
                m = len(b)
            end
            for i in 0 .. m
                let x: real[1] = nan
                if side == 0
                    x = a[i]
                else
                    x = b[i]
                end
                if isfinite(x)
                    let less: real[1] = 0.0
                    let eq: real[1] = 0.0
                    for j in 0 .. len(a)
                        if isfinite(a[j])
                            if a[j] < x
                                less = less + 1.0
                            elif a[j] == x
                                eq = eq + 1.0
                            end
                        end
                    end
                    for j in 0 .. len(b)
                        if isfinite(b[j])
                            if b[j] < x
                                less = less + 1.0
                            elif b[j] == x
                                eq = eq + 1.0
                            end
                        end
                    end
                    ties = ties + eq*eq - 1.0
                    if side == 0
                        r1 = r1 + less + (eq + 1.0)/2.0
                    end
                end
            end
        end
        let f1 = real(n1)
        let f2 = real(n2)
        let ntot = f1 + f2
        let u1 = r1 - f1*(f1 + 1.0)/2.0
        u = min(u1, f1*f2 - u1)
        let mu = f1*f2/2.0
        let var = f1*f2/12.0*((ntot + 1.0) - ties/(ntot*(ntot - 1.0)))
        if var <= 0.0
            z = 0.0
            p = 1.0
        else
            z = 0.0
            if abs(u1 - mu) > 0.5
                z = (abs(u1 - mu) - 0.5)/sqrt(var)
            end
            p = 1.0 - erf(z/sqrt(2.0))
        end
    end
end
