## The gravity-gradient torque, transcribed from adcs-sim-core torques.rs (torques: gg; the twin's asils.env.torques):
## 3 mu / |r|^5 (r_b x J r_b) with r_b the position in body axes (Wertz 1978, eq. 17-37, written with the position
## rather than its unit vector).
## The developer's transcription (S7.4), unsigned.
module gravgrad

## The gravity-gradient torque [N m], body axes, at the inertial position r, rm the inertial-to-body matrix, j the
## inertia (body axes) and mu the Earth's gravitational parameter.
fn gravity_gradient_torque(rm: mat3[1] in -1 .. 1, r: vec3[m] in -8e6 .. 8e6, j: mat3[kg m^2] in 0.001 .. 1, \
                           mu: real[m^3/s^2] in 3.9e14 .. 4e14) -> tau: vec3[N m]
    let rb = rm*r
    let rn = norm(rb)
    tau = cross(rb, j*rb)*(3.0*mu/(rn^5))
end
