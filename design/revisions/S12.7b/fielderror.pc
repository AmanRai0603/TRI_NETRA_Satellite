## The truth's field error, truth-only (S12.7b, E5; DR-env-005): what the truth field has that the onboard model does not, the
## two terms of the decision's default, seen only by the sensors and the torques, never by the flight software.
##   - the ring current's uniform external field, a dipole-aligned field of Dst nT at the Earth's centre;
##   - the crust: random Gauss coefficients above the IGRF's degree 13, to degree 20, scaled so that the field's root-mean-square
##     over the sphere at the orbit's radius is a stated value.
## The magnitudes and the form are the developer's (DR-env-005, unsigned). The developer's transcription (S12.7b), unsigned.
module fielderror

## IGRF's reference radius a [km] (the radius the Gauss coefficients are defined at; E10).
const FE_A = 6371.2
## The crust's degrees: the first above the IGRF's degree 13 and the last.
const FE_N_MIN = 14
const FE_N_MAX = 20
## The number of its coefficients: 2 n + 1 for each degree, n = 14 .. 20, in the IGRF's order (for each degree, g(n,0), then g(n,m), h(n,m)
## for m = 1 .. n).
const FE_NCOEF = 245

## The ring current's field, uniform, in the Earth-fixed frame [nT]: Dst [nT] along the geomagnetic dipole axis, against the field
## the dipole has at the equator. The Dessler-Parker-Sckopke relation (Dessler and Parker 1959, JGR 64(12):2239; Sckopke 1966,
## JGR 71(13):3125) gives the disturbance field of a ring current at the Earth's centre, dB/B0 = -(2/3) E_R/E_M, B0 the
## equatorial surface field of the dipole, E_R the ring current's particle energy, E_M the dipole field's energy outside the Earth;
## the Dst index is taken as that disturbance, the magnetopause currents and the Earth's induced currents (the corrections
## of a Dst that is not the ring current's alone) left out, and the field as uniform over the orbit (the ring current is
## outside it). The dipole's moment is the coefficients' (g10, g11, h11) = (gh[0], gh[1], gh[2]), at the run's date: its
## direction is (g11, h11, g10) in the Earth-fixed frame, the field at its equator against it, so the disturbance of a
## negative Dst (a depression of the equatorial field) is Dst against the field, which is -Dst along the moment.
fn ring_current_ecef(dst: real[1] in -2000 .. 100, gh: real[1][195] in -30000 .. 30000) -> b: vec3[1]
    let m = sqrt(gh[1]*gh[1] + gh[2]*gh[2] + gh[0]*gh[0])
    b = [-dst*gh[1]/m, -dst*gh[2]/m, -dst*gh[0]/m]
end

## The crust's Gauss coefficients [nT], drawn from the stream g (a Gaussian each, in the IGRF's order). Each degree n carries the same
## mean-square field, rms^2/(the number of degrees), at the radius r0 = R_E + alt_km (the orbit's radius), by the Lowes-Mauersberger
## spectrum (Lowes 1966, JGR 71(8):2179: the mean square of the field over the sphere of radius r is the sum over n of
## (n + 1) (a/r)^(2 n + 4) times the sum over m of (g^2 + h^2)): a coefficient of degree n has the variance
##   sigma_n^2 = rms^2 / (K (n + 1) (2 n + 1)) (r0/a)^(2 n + 4),
## K = 7 degrees, so that the root-mean-square of the field's magnitude over the sphere at r0 is rms [nT].
fn crust_draw(rms: real[1] in 0 .. 1000, alt_km: real[1] in 150 .. 2000, g: inout stream) -> gc: real[1][245]
    let r0 = R_E/(1000.0 [m]) + alt_km
    let k = real(FE_N_MAX - FE_N_MIN + 1)
    let ci = 0
    for n in FE_N_MIN .. FE_N_MAX + 1
        let sig = rms/sqrt(k*real(n + 1)*real(2*n + 1))*pow(r0/FE_A, real(n + 2))
        for m in 0 .. n + 1
            let z = normal(g)
            gc[ci] = sig*z
            ci = ci + 1
            if m > 0
                let z2 = normal(g)
                gc[ci] = sig*z2
                ci = ci + 1
            end
        end
    end
end

## The crust's field in north, east, down [nT] at geodetic latitude, longitude and height [km]: the Schmidt semi-normalised recursion
## of the IGRF's synthesis (env_time_frames' igrf_ned) over the degrees 14 to 20 (the lower degrees are not summed: the recursion
## runs through them for the Legendre functions, and their coefficients are the IGRF's, in the truth's other term).
fn crust_ned(gc: real[1][245] in -10000 .. 10000, lat: real[1] in -1.5 .. 1.5, lon: real[1] in -3.1 .. 3.1, alt_km: real[1] in 150 .. 2000) -> b: vec3[1]
    let a = 6378.137
    let f = 1.0/298.257223563
    let bb = a*(1.0 - f)
    let ct = cos(pi/2 - lat)
    let st = sin(pi/2 - lat)
    let rho = sqrt((a*st)*(a*st) + (bb*ct)*(bb*ct))
    let r = sqrt(alt_km*alt_km + 2*alt_km*rho + (a*a*a*a*st*st + bb*bb*bb*bb*ct*ct)/(rho*rho))
    let cd = (alt_km + rho)/r
    let sd = (a*a - bb*bb)/rho*ct*st/r
    let oc = ct
    ct = ct*cd - st*sd
    st = st*cd + oc*sd
    let cphi: real[1][21] = 0
    let sphi: real[1][21] = 0
    for k in 1 .. FE_N_MAX + 1
        cphi[k] = cos(real(k)*lon)
        sphi[k] = sin(real(k)*lon)
    end
    let pmax = div((FE_N_MAX + 1)*(FE_N_MAX + 2), 2)
    let pp: real[1][240] = 0
    let dp: real[1][240] = 0
    pp[0] = 1
    pp[2] = st
    dp[2] = ct
    let a_r = (FE_A/r)*(FE_A/r)
    let m = 1
    let n = 0
    let ci = 0
    let br: real[1] = 0
    let bt: real[1] = 0
    let bp: real[1] = 0
    for pi_ in 2 .. pmax + 1
        let ix = pi_ - 1
        if n < m
            m = 0
            n = n + 1
            a_r = a_r*(FE_A/r)
        end
        if m < n and pi_ != 3
            let l1 = pi_ - n - 1
            let l2 = pi_ - 2*n
            let k1 = (2.0*real(n) - 1)/sqrt(real(n)*real(n) - real(m)*real(m))
            let k2 = sqrt(((real(n) - 1)*(real(n) - 1) - real(m)*real(m))/(real(n)*real(n) - real(m)*real(m)))
            pp[ix] = k1*ct*pp[l1] - k2*pp[l2]
            dp[ix] = k1*(ct*dp[l1] - st*pp[l1]) - k2*dp[l2]
        elif pi_ != 3
            let ln = pi_ - n - 2
            let kk = sqrt(1.0 - 1.0/(2.0*real(m)))
            pp[ix] = kk*st*pp[ln]
            dp[ix] = kk*(st*dp[ln] + ct*pp[ln])
        end
        if n >= FE_N_MIN
            if m == 0
                let c = a_r*gc[ci]
                br = br + real(n + 1)*c*pp[ix]
                bt = bt - c*dp[ix]
                ci = ci + 1
            else
                let gcs = gc[ci]*cphi[m] + gc[ci + 1]*sphi[m]
                let gs = -gc[ci]*sphi[m] + gc[ci + 1]*cphi[m]
                let c = a_r*gcs
                br = br + real(n + 1)*c*pp[ix]
                bt = bt - c*dp[ix]
                if st == 0
                    bp = bp - ct*a_r*gs*dp[ix]
                else
                    bp = bp - 1.0/st*a_r*real(m)*gs*pp[ix]
                end
                ci = ci + 2
            end
        end
        m = m + 1
    end
    let bx = -bt
    let by = bp
    let bz = -br
    b = [bx*cd + bz*sd, by, bz*cd - bx*sd]
end

## The truth's error field in J2000 [T, as plain numbers] at geodetic latitude, longitude [rad] and height, given the J2000 to
## Earth-fixed matrix, the Gauss coefficients at the date (the dipole's moment), the crust's coefficients and Dst [nT]: the
## crust turned north-east-down to Earth-fixed as the truth field is (truthfield's field_eci_at), the ring current's uniform field
## added there, both back to J2000.
fn field_error_eci_at(lat: real[1] in -1.5 .. 1.5, lon: real[1] in -3.1 .. 3.1, h: real[m] in 300000 .. 900000, c: mat3[1] in -1 .. 1, \
                      gh: real[1][195] in -30000 .. 30000, gc: real[1][245] in -10000 .. 10000, dst: real[1] in -2000 .. 100) -> b: vec3[1]
    let bn = crust_ned(gc, lat, lon, h/(1000.0 [m]))
    let sl = sin(lat)
    let cl = cos(lat)
    let so = sin(lon)
    let co = cos(lon)
    let br = ring_current_ecef(dst, gh)
    let be: vec3[1] = [(-sl*co*bn[0] - so*bn[1] - cl*co*bn[2] + br[0])*1e-9, (-sl*so*bn[0] + co*bn[1] - cl*so*bn[2] + br[1])*1e-9, (cl*bn[0] - sl*bn[2] + br[2])*1e-9]
    b = transpose(c)*be
end
