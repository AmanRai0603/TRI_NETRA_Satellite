## The star tracker's spots from its frame, transcribed from adcs-sim-core comp.rs (star_tracker::centroid, median; the
## twin's asils.comp.star_tracker.centroid): the background as the median of the frame and its spread as 1.4826 times the
## median absolute deviation (Rousseeuw and Croux 1993, JASA 88:1273: the robust sigma of a normal sample), the pixels
## above k_sigma of it brightest first (equal ones column by column), a spot for each more than 2 pixels inside the edge
## and 4 or more pixels (in x or y) from every spot found before it: the centre of gravity of the background-subtracted
## 5 x 5 window round it, negatives as 0, until the part's max_spots. The median is a selection (Hoare 1961, CACM 4(7):321,
## FIND: the value the code's select_nth gives), the order a stable merge sort (Knuth, The Art of Computer Programming 3,
## 5.2.4: the order the code's sort by brightness, then index, gives). The 1.4826, the 5 x 5 window, the margin and the
## exclusion as the engine flies them (1.0.0 code).
## The developer's transcription (S7.10), unsigned.
module stcentroid

## The middle one of three numbers.
fn st_med3(a: real[1] in -10 .. 10, b: real[1] in -10 .. 10, c: real[1] in -10 .. 10) -> m: real[1]
    m = max(min(a, b), min(max(a, b), c))
end

## The k-th smallest (from 0) of the first m numbers of s, reordering s so that none before it is larger and none after it
## smaller: Hoare's selection (FIND). Each part is split about a pivot, the middle of its first, middle and last numbers
## (of three such middles, spread over it, above 1000 numbers), in a single pass that moves every number it meets
## (Lomuto's partition, without branches): those below the pivot first; when none are and k is not among them, those
## equal to it next, so that every pass shrinks the part.
## length: 64
fn st_select(s: inout real[1][*] in -10 .. 10, m: int in 1 .. 64, k: int in 0 .. 63) -> v: real[1]
    let lo = 0
    let hi = m - 1
    let found = false
    settle max m + 1 until found or not (lo < hi)
        if lo < hi
            let mid = lo + div(hi - lo, 2)
            let p = st_med3(s[lo], s[mid], s[hi])
            if hi - lo > 1000
                let d = div(hi - lo, 8)
                p = st_med3(st_med3(s[lo], s[lo + d], s[lo + 2*d]), st_med3(s[mid - d], s[mid], s[mid + d]), \
                            st_med3(s[hi - 2*d], s[hi - d], s[hi]))
            end
            let lt = lo
            for i in lo .. hi + 1
                let x = s[i]
                s[i] = s[lt]
                s[lt] = x
                lt = lt + (if x < p then 1 else 0)
            end
            if k < lt
                hi = lt - 1
            elif lt > lo
                lo = lt
            else
                let eq = lt
                for i2 in lt .. hi + 1
                    let y = s[i2]
                    s[i2] = s[eq]
                    s[eq] = y
                    eq = eq + (if y > p then 0 else 1)
                end
                if k < eq
                    found = true
                else
                    lo = eq
                end
            end
        end
    end
    v = s[k]
end

## The median of the first m numbers of s (the mean of the two middle ones when m is even), reordering s.
## length: 64
fn st_median(s: inout real[1][*] in -10 .. 10, m: int in 1 .. 64) -> med: real[1]
    let k = div(m - 1, 2)
    let a = st_select(s, m, k)
    if rem(m, 2) == 1
        med = a
    else
        let b = inf
        for l in k + 1 .. m
            b = min(b, s[l])
        end
        med = (a + b)/2.0
    end
end

## One pass of the merge sort: the runs of w of src[0..m] merged in pairs into dst, by key (descending), a tie to the
## earlier run.
## length: 64
fn st_merge_desc(key: inout real[1][*] in 0 .. 10, src: inout int[*] in 0 .. 63, dst: inout int[*] in 0 .. 63, \
                 m: int in 0 .. 64, w: int in 1 .. 64) -> z: int
    z = 0
    let nb = div(m + 2*w - 1, 2*w)
    for bk in 0 .. nb
        let lo = bk*2*w
        let mid = min(lo + w, m)
        let hi = min(lo + 2*w, m)
        let i = lo
        let j = mid
        for k in lo .. hi
            if i < mid and (j >= hi or not (key[src[j]] > key[src[i]]))
                dst[k] = src[i]
                i = i + 1
            else
                dst[k] = src[j]
                j = j + 1
            end
        end
    end
end

## Order ix[0..m] by key (descending), equal keys in the order given: a bottom-up merge sort over tmp. How many passes.
## length: 64
fn st_sort_desc(key: inout real[1][*] in 0 .. 10, ix: inout int[*] in 0 .. 63, tmp: inout int[*] in 0 .. 63, \
                m: int in 0 .. 64) -> passes: int
    passes = 0
    let w = 1
    for it in 0 .. 62
        if w < m
            if rem(passes, 2) == 0
                let z0 = st_merge_desc(key, ix, tmp, m, w)
            else
                let z1 = st_merge_desc(key, tmp, ix, m, w)
            end
            passes = passes + 1
            w = 2*w
        end
    end
    if rem(passes, 2) == 1
        for i in 0 .. m
            ix[i] = tmp[i]
        end
    end
end

## The spots of a frame (n x n, column by column): the background bg as the median of the frame and its spread as 1.4826
## times the median absolute deviation (in work); the pixels above bg + k_sigma times it, brightest first (equal ones
## column by column; in ia, over ib); each more than 2 pixels inside the edge and 4 or more (in x or y) from every spot
## already found gives a spot: the centre of gravity of the background-subtracted 5 x 5 window round it (negatives as 0),
## [x, y, flux (e-)], until max_spots. How many.
## length: 576
fn st_centroid(img: inout real[1][*] in 0 .. 1e5, cam: StCamera, work: inout real[1][*] in 0 .. 1, ia: inout int[*] in 0 .. 1, \
               ib: inout int[*] in 0 .. 1) -> (spots: real[1][3][ST_SPOTS], ns: int)
    let n = cam.n
    let np = n*n
    for l in 0 .. np
        work[l] = img[l]
    end
    let bg = st_median(work, np)
    for l2 in 0 .. np
        work[l2] = |img[l2] - bg|
    end
    let mad = st_median(work, np)
    let sg = 1.4826*mad
    let thr = bg + cam.k_sigma*sg
    let m = 0
    for l3 in 0 .. np
        if img[l3] > thr
            ia[m] = l3
            m = m + 1
        end
    end
    let passes = st_sort_desc(img, ia, ib, m)
    let cap = min(cam.max_spots, ST_SPOTS)
    ns = 0
    let done = false
    for q in 0 .. m
        if not done
            let l4 = ia[q]
            let x = div(l4, n) + 1
            let y = rem(l4, n) + 1
            if not (x < 3 or y < 3 or x > n - 2 or y > n - 2)
                let xf = real(x)
                let yf = real(y)
                let near = false
                for s in 0 .. ns
                    if |spots[s][0] - xf| < 4.0 and |spots[s][1] - yf| < 4.0
                        near = true
                    end
                end
                if not near
                    let tot: real[1] = 0
                    let sx: real[1] = 0
                    let sy: real[1] = 0
                    for c in 0 .. 5
                        for r in 0 .. 5
                            let w = max(img[(x + c - 2 - 1)*n + (y + r - 2 - 1)] - bg, 0.0)
                            tot = tot + w
                            sx = sx + (real(c) - 2.0)*w
                            sy = sy + (real(r) - 2.0)*w
                        end
                    end
                    spots[ns] = [xf + sx/tot, yf + sy/tot, tot]
                    ns = ns + 1
                    if ns >= cap
                        done = true
                    end
                end
            end
        end
    end
end
