## A magnetorquer coil's command and its saturation, transcribed from adcs-sim-core actuators.rs (Mtq::apply: the
## coil's share of the body dipole command, clamped at the coil's largest dipole, the part's dipole_max_Am2), and the
## engine's clamp (adcs-sim-core pm.rs clamp, the bounds checked in that order) the actuators' limits take.
## The developer's transcription (S7.7), unsigned.
module coilsat

## The engine's clamp: lo below lo, hi above hi, else x (a nan stays nan).
fn act_clamp(x: real[1] in -2 .. 2, lo: real[1] in -1 .. 0, hi: real[1] in 0 .. 1) -> y: real[1]
    if x < lo
        y = lo
    elif x > hi
        y = hi
    else
        y = x
    end
end

## A coil's dipole command [A m^2]: its row p_j of the allocation times the body dipole command, saturated at +-m_max.
fn coil_command(p_j: real[1][3] in -2 .. 2, m_cmd: real[1][3] in -1 .. 1, m_max: real[1] in 0.01 .. 1) -> mc: real[1]
    mc = act_clamp(p_j[0]*m_cmd[0] + p_j[1]*m_cmd[1] + p_j[2]*m_cmd[2], -m_max, m_max)
end
