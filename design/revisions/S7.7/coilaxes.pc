## The magnetorquer coils' allocation, transcribed from adcs-sim-core actuators.rs (Mtq::new: the driver board's table)
## and la.rs (inv, mtv): the minimum-norm split of a body dipole over the fitted coil axes, the pseudo-inverse
## A^T (A A^T)^-1 of the nominal axes (the board knows the nominal axes, not the dispersed ones); A A^T inverted by its
## adjugate over the determinant (no check: fewer than three independent axes leave it singular, as flown).
## The developer's transcription (S7.7), unsigned.
module coilaxes

## m^-1 by the adjugate over the determinant by the first row (la.rs inv, with no check).
fn coil_inverse(m: real[1][3][3] in -3 .. 3) -> r: real[1][3][3]
    let d = det3(m)
    r = [[(m[1][1]*m[2][2] - m[1][2]*m[2][1])/d, (m[0][2]*m[2][1] - m[0][1]*m[2][2])/d, (m[0][1]*m[1][2] - m[0][2]*m[1][1])/d], \
         [(m[1][2]*m[2][0] - m[1][0]*m[2][2])/d, (m[0][0]*m[2][2] - m[0][2]*m[2][0])/d, (m[0][2]*m[1][0] - m[0][0]*m[1][2])/d], \
         [(m[1][0]*m[2][1] - m[1][1]*m[2][0])/d, (m[0][1]*m[2][0] - m[0][0]*m[2][1])/d, (m[0][0]*m[1][1] - m[0][1]*m[1][0])/d]]
end

## Each coil's row of the allocation A^T (A A^T)^-1 for the first n of the nominal axes (unit, body frame).
fn coil_allocation(axes: real[1][3][ACT_NS] in -1 .. 1, n: int in 3 .. 8) -> p: real[1][3][ACT_NS]
    let aat: real[1][3][3] = 0
    for j in 0 .. n
        for r in 0 .. 3
            for c in 0 .. 3
                aat[r][c] = aat[r][c] + axes[j][r]*axes[j][c]
            end
        end
    end
    let ai = coil_inverse(aat)
    p = 0
    for k in 0 .. n
        p[k] = transpose(ai)*axes[k]
    end
end
