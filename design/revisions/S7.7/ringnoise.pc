## A fluid momentum ring's flow noise, transcribed from adcs-sim-core actuators.rs (Mex::apply): the momentum the driver
## measures, the ring's own plus white noise of sigma the flow sensor's noise in momentum (k_hv times the part's
## flow_sensor_noise_m_s), one normal draw from the run's momentum-device noise stream per ring and step. Since S7.11 also
## the noise's sigma in momentum, which adcs-sim product.rs (fit_actuator_, rings) computed.
## The developer's transcription (S7.7; ring_flow_noise S7.11), unsigned.
module ringnoise

## The measured momentum [N m s]: h plus sigma_h times a normal draw from g.
fn measured_momentum(h: real[1] in -0.05 .. 0.05, sigma_h: real[1] in 0 .. 1e-4, g: inout stream) -> hm: real[1]
    let z = normal(g)
    hm = h + sigma_h*z
end

## The flow sensor's noise in momentum [N m s], one sigma: the ring's momentum per flow speed k_hv [N m s/(m/s)] times
## the part's flow_sensor_noise_m_s sigma [m/s].
fn ring_flow_noise(k_hv: real[1] in 1e-6 .. 0.1, sigma_v: real[1] in 0 .. 0.01) -> sigma_h: real[1]
    sigma_h = k_hv*sigma_v
end
