## The star tracker's attitude from its stars, transcribed from adcs-sim-core la.rs (qmethod, jacobi4: the onboard QUEST,
## Davenport's q-method) and comp.rs (star_tracker::attitude: the residual check): the attitude matrix B = sum b r^T of the
## measured (body or head) and catalogue (ECI) unit vectors, Davenport's K matrix and its eigenvector of the largest
## eigenvalue by the toolbox's cyclic Jacobi (Markley and Crassidis 2014, Fundamentals of Spacecraft Attitude
## Determination and Control, section 5.3); then, for identified stars, the star whose direction misses its catalogue
## star by the most is dropped while that miss is the part's fit tolerance or more and the fit repeated, solved with three
## stars or more left. An unidentified star is -1 (the code's NONE).
## The developer's transcription (S7.9), unsigned.
module stattitude

## The most spots a frame keeps (adcs-sim-core comp MAX_SPOTS).
const ST_SPOTS = 32

## Davenport's q-method on the first n pairs: b[l] = A r[l] (unit vectors); the attitude q (ECI to body, scalar last).
fn st_qmethod(b: real[1][3][ST_SPOTS] in -1 .. 1, r: real[1][3][ST_SPOTS] in -1 .. 1, n: int in 0 .. 32) -> q: quat
    let bm: real[1][3][3] = 0
    for l in 0 .. n
        for i in 0 .. 3
            for j in 0 .. 3
                bm[i][j] = bm[i][j] + b[l][i]*r[l][j]
            end
        end
    end
    let sg = bm[0][0] + bm[1][1] + bm[2][2]
    let z = [bm[1][2] - bm[2][1], bm[2][0] - bm[0][2], bm[0][1] - bm[1][0]]
    let k: real[1][4][4] = 0
    for i in 0 .. 3
        for j in 0 .. 3
            k[i][j] = bm[i][j] + bm[j][i] - (if i == j then sg else 0.0)
        end
        k[i][3] = z[i]
        k[3][i] = z[i]
    end
    k[3][3] = sg
    let lam, v = jacobi_eig4(k)
    let im = 0
    for i in 1 .. 4
        if lam[i] > lam[im]
            im = i
        end
    end
    q = qnorm([v[0][im], v[1][im], v[2][im], v[3][im]])
end

## The attitude (ECI to head) from the first n spots' directions b (head frame, unit) and their catalogue stars id (-1
## none), rs[p] the direction (ECI, unit) of spot p's catalogue star, dropping the worst star while its miss is tol [rad]
## or more: (q, solved). id keeps the stars the fit used.
fn st_attitude(b: real[1][3][ST_SPOTS] in -1 .. 1, rs: real[1][3][ST_SPOTS] in -1 .. 1, n: int in 0 .. 32, \
               id: inout int[ST_SPOTS] in -1 .. 3999, tol: real[1] in 0 .. 0.01) -> (q: quat, ok: bool)
    q = [0.0, 0.0, 0.0, 1.0]
    ok = false
    let done = false
    for it in 0 .. n
        if not done
            let k: int[ST_SPOTS] = 0
            let nk = 0
            for p in 0 .. n
                if id[p] >= 0
                    k[nk] = p
                    nk = nk + 1
                end
            end
            if nk < 3
                done = true
            else
                let bb: real[1][3][ST_SPOTS] = 0
                let rr: real[1][3][ST_SPOTS] = 0
                for i in 0 .. nk
                    bb[i] = b[k[i]]
                    rr[i] = rs[k[i]]
                end
                q = st_qmethod(bb, rr, nk)
                let a = dcm(q)
                let rm = -inf
                let j = 0
                for i in 0 .. nk
                    let c = dot(bb[i], a*rr[i])
                    let res = acos(if c < 1.0 then c else 1.0)
                    if res > rm
                        rm = res
                        j = i
                    end
                end
                if rm < tol
                    ok = true
                    done = true
                else
                    id[k[j]] = -1
                end
            end
        end
    end
end
